static u32 riscv64_has_features(const u64 *features, u32 handle) {
   const isa_sets_row *set  = riscv64_isa_sets + riscv64_iform_isa[handle];
   u32                 held = 0;
   u32                 index;
   u32                 item;

   for (index = 0; index < set->count; ++index) {
      item  = riscv64_isa_items[set->first + index];
      held |= BIT_HELD(features, item & FEATURE_MASK);
      if (item & FEATURE_LAST) {
         if (!held) {
            return 0;
         }

         held = 0;
      }
   }

   return 1;
}

static u32 riscv64_mnemonic(u32 handle) {
   if (handle >= COUNT_OF(riscv64_iform_mnemonics)) {
      return 0;
   }

   return riscv64_iform_mnemonics[handle];
}

#if NYASM_FORMAT || NYASM_METADATA || NYASM_UIR

static const char *riscv64_string(u32 string) {
   return (const char *)riscv64_strings + riscv64_string_offsets[string];
}

#endif

#if NYASM_UIR

static const char *riscv64_uir_name(u32 name) {
   if (name >= COUNT_OF(riscv64_uir_names)) {
      return "";
   }

   return riscv64_string(name);
}

#endif

