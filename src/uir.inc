   u32 more  = 1;
   u32 word;
   u32 low;
   u64 bits;

   for (word = 0; word < limit; ++word) {
      words[word] = 0;
   }

   while (more) {
      bits = code[*at] & 0x7F;
      more = code[*at] >= 0x80;
      word = BIT_WORD(shift);
      low  = shift & BIT_WORD_MASK;
      *at += 1;
      if (word < limit) {
         words[word] |= bits << low;
      }

      if (low > 57 && word + 1 < limit) {
         words[word + 1] |= bits >> (64 - low);
      }

      shift += 7;
   }

   for (word = 0; word < limit; ++word) {
      if (words[word]) {
         used = word + 1;
      }
   }

   return used;
}

