   u32 base  = entry[UIR_ENTRY_BASE];
   u32 lazy  = node->operation == NYASM_UIR_OPERATION_ITE;
   u32 found = 0;
   u32 index;
   u32 child;
   u32 term;

   for (index = 0; index < node->count; ++index) {
      child = uir_child(node);
      term  = uir_memo_find(terms, child, frame);
      if (index < 3) {
         held[index] = term;
      }

      if (lazy && index && TERM_CONST(terms, held[0]) && (index == 1) != (TERM_VALUE(terms, held[0]) != 0)) {
         held[index] = held[0];
      } else if (!term) {
         uir_push(terms, child, frame, base);
         found = 1;
      }

      if (lazy && found) {
         return 1;
      }
   }

   return found;
}

static u32 uir_run(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 root, u32 frame, u32 base) {
   nyasm_uir_node node;
   u32           *entry;
   u32            held[3];
   u32            floor = terms->depth;
   u32            found;

   uir_push(terms, root, frame, base);
   while (terms->depth > floor && !terms->failed) {
      entry = terms->stack + (terms->depth - 1) * UIR_ENTRY_WORDS;
      if (uir_memo_find(terms, entry[UIR_ENTRY_OFFSET], entry[UIR_ENTRY_FRAME])) {
         --terms->depth;
         continue;
      }

      uir_read(machine->arch, entry[UIR_ENTRY_OFFSET], &node);
      held[0] = 0;
      held[1] = 0;
      held[2] = 0;
      found   = 0;
      if (entry[UIR_ENTRY_MADE]) {
         found = uir_called(terms, &node, entry);
      } else if (!uir_missing(terms, &node, entry, held)) {
         uir_read(machine->arch, entry[UIR_ENTRY_OFFSET], &node);
         switch (node.operation) {
            case NYASM_UIR_OPERATION_CONST:
               found = uir_wide_constant(terms, &node);
               break;
            case NYASM_UIR_OPERATION_INPUT:
               found = uir_leaf(terms, machine, &node, entry[UIR_ENTRY_BASE], held[0]);
               break;
            case NYASM_UIR_OPERATION_EXTRACT:
               found = term_make(terms, NYASM_UIR_OPERATION_EXTRACT, node.width, held[0], 0, 0, node.auxiliary);
               break;
            case NYASM_UIR_OPERATION_LOAD:
               if (machine->load) {
                  found = machine->load(machine->user, held[0], node.width, (u32)node.auxiliary);
               } else {
                  found = term_find(terms, NYASM_UIR_OPERATION_LOAD, node.width, 0, held[0], 0, node.auxiliary);
               }

               break;
            case NYASM_UIR_OPERATION_LOOKUP:
               found = uir_lookup(terms, &node, held[0]);
               break;
            case NYASM_UIR_OPERATION_CONCAT:
            case NYASM_UIR_OPERATION_ENV:
               found = uir_joined(terms, machine, &node, entry[UIR_ENTRY_FRAME]);
               break;
            case NYASM_UIR_OPERATION_CALL:
               uir_enter(terms, &node, entry, 0);
               break;
            case NYASM_UIR_OPERATION_MAP:
               uir_enter(terms, &node, entry, 1);
               break;
            case NYASM_UIR_OPERATION_FOLD:
            case NYASM_UIR_OPERATION_NONE:
               found = term_find(terms, node.operation, node.width, 0, 0, 0, node.offset);
               break;
            default:
               found = term_make(terms, node.operation, node.width, held[0], held[1], held[2], 0);
               break;
         }
      }

      if (found) {
         uir_memo_set(terms, entry[UIR_ENTRY_OFFSET], entry[UIR_ENTRY_FRAME], found);
         --terms->depth;
      }
   }

   terms->depth = floor;
   return uir_memo_find(terms, root, frame);
}

static u32 uir_value(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 root) {
   return uir_run(terms, machine, root, 0, 0);
}

INLINE u32 uir_apply(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 function, const u32 *arguments,
                          u32 count) {
   u32 *block;
   u32  mark  = terms->arguments;
   u32  found = 0;
   u32  index;

   block = uir_reserve(terms, count);
   if (block) {
      for (index = 0; index < count; ++index) {
         block[index] = arguments[index];
      }

      ++terms->frames;
      found = uir_run(terms, machine, machine->arch->functions[function].result, terms->frames,
                      terms->arguments);
   }

   terms->arguments = mark;
   return found;
}

static void uir_fresh(nyasm_terms *terms) {
   u32 index;

   ++terms->epoch;
   terms->frames    = 0;
   terms->memo_used = 0;
   if (!terms->epoch) {
      for (index = 0; index <= terms->memo_mask; ++index) {
         terms->memo[UIR_MEMO_WORDS * index + 2] = 0;
      }

      terms->epoch = 1;
   }
}

static u32 uir_evaluate(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 node) {
   uir_fresh(terms);
   return uir_value(terms, machine, node);
}

static u32 uir_gather(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 number, u32 kinds) {
   nyasm_uir_effect effect;
   nyasm_uir_run    run;
   u32             *saved;
   u32              count = 0;
   u32              index;
   u32              guard;

   uir_start(machine->arch, number, &run);
   while (uir_next(&run, &effect) && !terms->failed) {
      if (kinds >> effect.kind & 1) {
         saved = uir_reserve(terms, UIR_SAVED_WORDS);
         if (saved) {
            guard = 0;
            if (effect.nodes[NYASM_UIR_GUARD] != NYASM_UIR_NONE) {
               guard = uir_value(terms, machine, effect.nodes[NYASM_UIR_GUARD]);
            }

            saved[NYASM_UIR_EFFECT_NODES] = !guard || !TERM_CONST(terms, guard) || TERM_VALUE(terms, guard);
            for (index = 0; index < NYASM_UIR_EFFECT_NODES; ++index) {
               saved[index] = 0;
               if (index == NYASM_UIR_GUARD) {
                  saved[index] = guard;
               } else if (saved[NYASM_UIR_EFFECT_NODES] && effect.nodes[index] != NYASM_UIR_NONE) {
                  saved[index] = uir_value(terms, machine, effect.nodes[index]);
               }
            }

            ++count;
         }
      }
   }

   return count;
}

static u32 uir_deliver(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 number, u32 kinds, u32 *at) {
   nyasm_uir_effect effect;
   nyasm_uir_run    run;
   const u32       *saved;
   u32              count = 0;

   uir_start(machine->arch, number, &run);
   while (uir_next(&run, &effect) && *at > terms->arguments) {
      if (kinds >> effect.kind & 1) {
         *at  -= UIR_SAVED_WORDS;
         saved = terms->stack + *at;
         if (saved[NYASM_UIR_EFFECT_NODES]) {
            machine->effect(machine->user, &effect, saved);
            ++count;
         }
      }
   }

   return count;
}

static u32 uir_execute(nyasm_terms *terms, const nyasm_uir_machine *machine, u32 handle, u32 kinds) {
   u32 mark  = terms->arguments;
   u32 at    = mark;
   u32 count = 0;

   if (handle >= machine->arch->template_count || !machine->effect) {
      return 0;
   }

   uir_fresh(terms);
   uir_gather(terms, machine, machine->arch->templates[handle].check, kinds);
   uir_gather(terms, machine, machine->arch->templates[handle].body, kinds);
   if (!terms->failed) {
      count  = uir_deliver(terms, machine, machine->arch->templates[handle].check, kinds, &at);
      count += uir_deliver(terms, machine, machine->arch->templates[handle].body, kinds, &at);
   }

   terms->arguments = mark;
   return count;
}
