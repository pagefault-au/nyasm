static u32 arm64_open(arm64_renderer *render, char first) {
   if (render->quiet) {
      return 0;
   }

   if (render->out.pending && first != ']') {
      put_character(&render->out, ' ');
   }

   render->out.pending = 0;
   return 1;
}

static void arm64_put(arm64_renderer *render, char character) {
   if (render->quiet) {
      return;
   }

   if (character == ' ') {
      render->out.pending = 1;
      return;
   }

   arm64_open(render, character);
   put_character(&render->out, character);
}

static void arm64_put_text(arm64_renderer *render, const char *text, u32 lower) {
   char character;

   while (*text) {
      character = *text;
      if (lower && character >= 'A' && character <= 'Z') {
         character += 'a' - 'A';
      }

      arm64_put(render, character);
      text += 1;
   }
}

static void arm64_put_signed(arm64_renderer *render, u64 value) {
   if (arm64_open(render, '0')) {
      put_signed(&render->out, (i64)value);
   }
}

static void arm64_put_decimal(arm64_renderer *render, u64 value) {
