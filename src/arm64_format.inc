static void arm64_row(arm64_renderer *render) {
   const u8   *code  = arm64_code;
   const char *texts[2];
   u32         kind  = code[render->at];
   u32         stack = 0;
   u32         count;

   render->at += 1;
   if (kind == ARM64_ROW_TEXT) {
      arm64_put_text(render, arm64_template_string(render), 0);
   }

   if (kind == ARM64_ROW_HASH) {
      arm64_put(render, '#');
   }

   if (kind == ARM64_ROW_NUMBER || kind == ARM64_ROW_HASH) {
      arm64_put_signed(render, arm64_expression(render));
   }

   if (kind == ARM64_ROW_STACK) {
      texts[1]    = arm64_template_string(render);
      texts[0]    = arm64_template_string(render);
      count       = code[render->at];
      render->at += 1;
      while (count) {
         stack |= arm64_expression(render) == 31;
         count -= 1;
      }

      arm64_put_text(render, texts[stack], 0);
   }
}

