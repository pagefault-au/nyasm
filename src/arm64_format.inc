   u32 levels = (1u << length) - 1;
   u32 width  = 1u << length;
   u32 turn   = immr & levels;
   u64 item   = arm64_ones((imms & levels) + 1);
   u64 mask   = 0;
   u32 at;

   if (turn) {
      item = (item >> turn | item << (width - turn)) & arm64_ones(width);
   }

   for (at = 0; at < 64; at += width) {
      mask |= item << at;
   }

   *size = width;
   return mask;
}

