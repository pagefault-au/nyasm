   arm64_put_text(render, arm64_template_string(render), 1);
}

static void arm64_print_register(arm64_renderer *render) {
   const char *prefix = arm64_template_string(render);
   const char *last   = arm64_template_string(render);
   u64         value  = arm64_expression(render);

   if (value == 31 && *last) {
      arm64_put_text(render, last, 0);
      return;
   }

   arm64_put_text(render, prefix, 0);
   arm64_put_decimal(render, value);
}

static void arm64_print_immediate(arm64_renderer *render) {
   u32 plain = arm64_code[render->at];
   u64 value;

   render->at += 1;
   value       = arm64_expression(render);
   if (plain) {
      arm64_put_decimal(render, value);
      return;
   }

   arm64_put_signed(render, value);
}

static void arm64_print_float(arm64_renderer *render) {
   u64 packed = arm64_expression(render);
   u32 shift  = 7 - ((packed >> 4 & 7) ^ 4);
   u64 whole  = 16 + (packed & 15);
   u64 rest   = whole & arm64_ones(shift);

   if (packed >> 7 & 1) {
      arm64_put(render, '-');
   }

   arm64_put_decimal(render, whole >> shift);
   arm64_put(render, '.');
   do {
      rest *= 10;
      arm64_put(render, (char)('0' + (rest >> shift)));
      rest &= arm64_ones(shift);
   } while (rest);
}

static void arm64_print_label(arm64_renderer *render) {
   arm64_put(render, '#');
   arm64_put_signed(render, arm64_expression(render));
}

static void arm64_print_mask(arm64_renderer *render) {
   u32 wide = arm64_code[render->at];
   u32 size;
   u64 mask;

   render->at += 1;
   mask        = arm64_bit_mask(arm64_expression(render), &size);
   if (wide == 0) {
      mask &= 0xFFFFFFFF;
   }

   if (wide == 2) {
      mask &= arm64_ones(size);
   }

   arm64_put_decimal(render, mask);
}

static void arm64_print_alternative(arm64_renderer *render) {
   u64 wanted = arm64_number(render);
   u32 other  = arm64_expression(render) != wanted;

   render->quiet += other;
   arm64_item(render);
   render->quiet -= other;
   render->quiet += !other;
   arm64_item(render);
   render->quiet -= !other;
}

static void arm64_print_table(arm64_renderer *render) {
   const u8 *code      = arm64_code;
   u32       fallback  = code[render->at];
   u64       otherwise = 0;
   u32       matched   = 0;
   u64       key;
   u64       mask;
   u64       value;
   u32       count;
   u32       skip;

   render->at += 1;
   if (fallback) {
      otherwise = arm64_expression(render);
   }

   key         = arm64_expression(render);
   count       = code[render->at];
   render->at += 1;
   while (count) {
      mask           = arm64_number(render);
      value          = arm64_number(render);
      skip           = matched || (key & mask) != value;
      render->quiet += skip;
      arm64_row(render);
      render->quiet -= skip;
      matched       |= !skip;
      count         -= 1;
   }

   if (!matched && fallback) {
      arm64_put(render, '#');
      arm64_put_signed(render, otherwise);
   }
}

static void arm64_print_optional(arm64_renderer *render) {
   u32 hidden = !arm64_expression(render);

   render->quiet += hidden;
   arm64_items(render);
   render->quiet -= hidden;
}

static const arm64_item_printer arm64_printers[ARM64_ITEM_COUNT] = {
   [ARM64_ITEM_TEXT]        = arm64_print_text,
   [ARM64_ITEM_REGISTER]    = arm64_print_register,
   [ARM64_ITEM_IMMEDIATE]   = arm64_print_immediate,
   [ARM64_ITEM_FLOAT]       = arm64_print_float,
   [ARM64_ITEM_LABEL]       = arm64_print_label,
   [ARM64_ITEM_MASK]        = arm64_print_mask,
   [ARM64_ITEM_ALTERNATIVE] = arm64_print_alternative,
   [ARM64_ITEM_TABLE]       = arm64_print_table,
   [ARM64_ITEM_OPTIONAL]    = arm64_print_optional,
};

static void arm64_item(arm64_renderer *render) {
   u32 kind = arm64_code[render->at];

   render->at += 1;
   arm64_printers[kind](render);
}

static void arm64_items(arm64_renderer *render) {
   while (arm64_code[render->at] != ARM64_ITEM_END) {
      arm64_item(render);
   }

   render->at += 1;
}

static u32 arm64_format(const arm64_context *context, const arm64_instruction *found, u64 address UNUSED,
                       char *text, u32 capacity) {
   const word_aliases_row *alias;
   arm64_renderer           render;
   arm64_detail             detail;
   u32                     aliases = 1;
   u32                     at;
   u32                     index;

   render.quiet = 0;
   text_start(&render.out, text, capacity);
   if (!arm64_decode_detail(context, found, &detail)) {
      put_text(&render.out, "(bad)");
      return text_end(&render.out);
   }

   aliases = !(context->flags & ARM64_NO_ALIASES);

   render.encoding = arm64_encodings + detail.encoding;
   at              = arm64_templates[render.encoding->template_];
   for (index = 0; index < detail.field_count; ++index) {
      render.values[index] = detail.fields[index];
   }

   index = arm64_alias_firsts[detail.encoding];
   for (; aliases && index < arm64_alias_firsts[detail.encoding + 1]; ++index) {
      alias     = arm64_aliases + index;
      render.at = alias->condition;
      if ((detail.word & alias->mask) == alias->value && arm64_expression(&render)) {
         at = alias->template_;
         break;
      }
   }

   render.at = at;
   arm64_items(&render);
   return text_end(&render.out);
}

static u32 arm64_disassemble(const arm64_context *context, const u8 *bytes, u32 size, u64 address, char *text,
                            u32 capacity) {
   arm64_instruction found;
   u32              length = arm64_decode(context, bytes, size, &found);

   arm64_format(context, &found, address, text, capacity);
   return length;
}
