static u32 arm32_has_features(const u64 *features, u32 handle) {
   const isa_sets_row *set  = arm32_isa_sets + arm32_iform_isa[handle];
   u32                 held = 0;
   u32                 index;
   u32                 item;

   for (index = 0; index < set->count; ++index) {
      item  = arm32_isa_items[set->first + index];
      held |= BIT_HELD(features, item & FEATURE_MASK);
      if (item & FEATURE_LAST) {
         if (!held) {
            return 0;
         }

         held = 0;
      }
   }

   return 1;
}

static u32 arm32_mnemonic(u32 handle) {
   if (handle >= COUNT_OF(arm32_iform_mnemonics)) {
      return 0;
   }

   return arm32_iform_mnemonics[handle];
}

#if NYASM_FORMAT || NYASM_METADATA || NYASM_UIR

static const char *arm32_string(u32 string) {
   return (const char *)arm32_strings + arm32_string_offsets[string];
}

#endif

#if NYASM_UIR

static const char *arm32_uir_name(u32 name) {
   if (name >= COUNT_OF(arm32_uir_names)) {
      return "";
   }

   return arm32_string(name);
}

#endif

