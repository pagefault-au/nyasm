      at = x86_put(at, &syntax->memory_open);
      if (based) {
         at = x86_put_register(at, syntax, address.base, 1);
      }

      if (indexed) {
         at = x86_put_if(at, &syntax->memory_plus, based);
         at = x86_put_register(at, syntax, address.index, 1);
         if (address.scale || !based) {
            at  = x86_put(at, &syntax->memory_scale);
            *at = (char)('0' + (1u << address.scale));
            ++at;
         }
      }

      keep = at;
      if (UNLIKELY(size)) {
         at   = x86_put_if(at, &syntax->memory_plus, named);
         size = syntax->print_symbol(syntax->user, target, at, X86_FORMAT_HOOK);
         at   = x86_put_hook(at, size);
         if (!size) {
            at = keep;
         }
      }

      if (at == keep) {
         if (!named) {
            at = x86_put_signed(at, syntax, value, minus);
         } else if (address.offset) {
            at = x86_put_either(at, &syntax->memory_plus, &syntax->memory_minus, minus, 1);
            at = x86_put_number(at, syntax, value);
         }
      }

      at = x86_put(at, &syntax->memory_close);
   }

   if (UNLIKELY(kind == X86_TOKEN_MEMORY && X86_TOKEN_NUMBER(code))) {
      at  = x86_put_text(at, "{1to", 0);
      at += text_decimal(at, X86_TOKEN_NUMBER(code));
      *at = '}';
      ++at;
   }

   return at;
}

static TEXT_APART char *x86_put_hooked(char *at, const nyasm_x86_syntax *syntax, const u8 *bytes,
                                       const x86_view *view, u64 code, u64 next) {
   return x86_put_address(at, syntax, bytes, view, code, next, 1);
}

FORCE_INLINE u32 x86_format_line(const x86_context *context, const u8 *bytes, const x86_view *view, u64 address,
                                 const nyasm_x86_syntax *syntax, char *text, u32 careful) {
   const nyasm_x86_mark *mark     = &syntax->gap;
   const u64            *tokens;
   const u8             *letters;
   const char           *named    = 0;
   char                 *at       = text;
   char                 *start;
   char                 *made;
   u64                   first;
   u64                   second;
   u64                   code;
   u64                   value;
   u64                   extended;
   u64                   sign;
   u64                   next;
   i64                   step     = 1;
   u32                   spelling = syntax->mnemonics;
   u32                   upper    = syntax->letters;
   u32                   visible  = X86_TOKEN_USUAL;
   u32                   dropped  = 0;
   u32                   row      = view->handle;
   u32                   count;
   u32                   traits;
   u32                   name;
   u32                   size;
   u32                   split;
   u32                   lanes;
   u32                   high;
   u32                   number;
   u32                   flags;
   u32                   index;
   u32                   bits;
   u32                   minus;
   u32                   kind;
   u32                   kept;

   if (UNLIKELY(spelling > NYASM_X86_SYNTAX_PUSHFQ)) {
      spelling = NYASM_X86_SYNTAX_INTEL;
   }

   if (UNLIKELY(!view->length)) {
      at  = x86_put_text(at, "(bad)", 0);
      *at = 0;
      return (u32)(at - text);
   }

   first  = x86_format_rows[2 * row];
   second = x86_format_rows[2 * row + 1];
   if (UNLIKELY(X86_ROW_TRAITS(second) & (X86_TRAIT_SPLIT | X86_TRAIT_SIZED))) {
      row    = x86_format_variant(row, X86_VIEW_ENCODING(view), X86_VIEW_SIZE(view) >> 5, X86_VIEW_ADDRESS(view) >> 5);
      first  = x86_format_rows[2 * row];
      second = x86_format_rows[2 * row + 1];
   }

   name   = x86_format_names[X86_ROW_NAME(first, second, spelling)];
   traits = X86_ROW_TRAITS(second);
   count  = X86_ROW_COUNT(second);
   tokens = x86_format_tokens + X86_ROW_TOKENS(first);
   next   = address + view->length;
   high   = (view->extension & NYASM_X86_EXTENSION_B) << 3 | (view->extension & NYASM_X86_EXTENSION_B4);
   lanes  = (view->body >> 3 & 0x0700) | (view->body << 8 & 0x070000) | (view->body << 24 & 0x07000000);
   lanes |= ((view->extension & NYASM_X86_EXTENSION_R) << 1 | (view->extension & NYASM_X86_EXTENSION_R4) >> 2) << 8;
   lanes |= high << 16 | high << 24;
   if (UNLIKELY(!(view->flags & NYASM_X86_DETAIL_LONG_MODE))) {
      lanes &= 0x07070700;
   }

   if (syntax->implicit != NYASM_X86_IMPLICIT_USUAL) {
      visible = X86_TOKEN_USUAL | X86_TOKEN_IMPLICIT;
   }

   if (UNLIKELY(X86_ROW_DECIDES(second))) {
      value = 0;
      for (index = 0; index < count; ++index) {
         code = tokens[index];
         if (X86_TOKEN_FLAGS(code) & X86_TOKEN_DECIDES) {
            value = x86_view_immediate(bytes, view, X86_TOKEN_EXTRA(code));
            if (X86_TOKEN_FLAGS(code) & X86_TOKEN_NIBBLE) {
               value &= 15;
            }
         }
      }

      index = X86_ROW_DECIDES(second) & (X86_NAME_TEN - 1);
      if (index && value < (u64)x86_format_predicate_firsts[index + 1] - x86_format_predicate_firsts[index]) {
         if (*x86_format_predicates[x86_format_predicate_firsts[index] + value]) {
            named   = x86_format_predicates[x86_format_predicate_firsts[index] + value];
            dropped = X86_TOKEN_DECIDES;
         }
      }

      if ((X86_ROW_DECIDES(second) & X86_NAME_TEN) && value == 10 && visible == X86_TOKEN_USUAL) {
         count = 0;
      }
   }

   if (UNLIKELY((view->lead & X86_LEAD_WORDS) | (traits & X86_TRAIT_WORDS))) {
      at = x86_put_prefixes(context, bytes, view, first, second, syntax, at);
   }

   start   = at;
   letters = x86_format_text + (name & ((1u << X86_NAME_SIZE) - 1));
   size    = name >> X86_NAME_SIZE & X86_NAME_NO_SPLIT;
   split   = name >> X86_NAME_SPLIT;
   number  = 0;
   if (careful && syntax->print_mnemonic) {
      number = syntax->print_mnemonic(syntax->user, view->handle, at, X86_FORMAT_HOOK);
      at     = x86_put_hook(at, number);
   }

   if (!number) {
      if (UNLIKELY(split != X86_NAME_NO_SPLIT)) {
         for (index = 0; index < split; ++index) {
            at[index] = (char)letters[index];
         }

         at += split;
         if (named) {
            at = x86_put_text(at, named, 0);
         }

         for (index = split; index < size; ++index) {
            *at = (char)letters[index];
            ++at;
         }
      } else {
         copy16((u8 *)at, letters);
         if (UNLIKELY(size > 16)) {
            copy16((u8 *)at + 16, letters + 16);
         }

         at += size;
      }

      if (UNLIKELY(upper)) {
         for (index = 0; start + index < at; ++index) {
            if (start[index] >= 'a' && start[index] <= 'z') {
               start[index] = (char)(start[index] - 'a' + 'A');
            }
         }
      }
   }

   if (syntax->sizes == NYASM_X86_SIZES_TYPES) {
      at = x86_put_if(at, &syntax->type_mark, X86_ROW_TYPE(second));
      at = x86_put(at, x86_format_types + X86_ROW_TYPE(second));
   }

   if (UNLIKELY(traits & X86_TRAIT_DFV)) {
      at = x86_put_flags(at, view);
   }

   if (syntax->order == NYASM_X86_ORDER_SOURCE && !(traits & X86_TRAIT_KEEP) && count) {
      tokens += count - 1;
      step    = -1;
   }

   for (index = 0; index < count; ++index, tokens += step) {
      code  = *tokens;
      flags = X86_TOKEN_FLAGS(code);
      kind  = X86_TOKEN_KIND(code);
      if (UNLIKELY(!(flags & visible) || (flags & dropped))) {
         continue;
      }

      if (kind == X86_TOKEN_REGISTER) {
         number = lanes >> (8 * X86_TOKEN_EXTRA(code)) & 31;
         at     = x86_put(at, mark);
         if (UNLIKELY(code & X86_TOKEN_ODD)) {
            if (X86_TOKEN_NUMBER(code)) {
               number = x86_format_number(bytes, view, code);
               if (!(view->flags & NYASM_X86_DETAIL_LONG_MODE)) {
                  number &= 7;
               }
            }

            if ((flags & X86_TOKEN_HIGH) && number - 4 < 4 && !(view->flags & NYASM_X86_DETAIL_REX)
                && !(x86_format_escapes[view->escape] & 1)) {
               number += X86_FORMAT_HIGH;
            }

            if (flags & X86_TOKEN_STAR) {
               at = x86_put(at, &syntax->indirect_mark);
            }
         }

         number += X86_TOKEN_BASE(code);
         size    = 0;
         if (careful && syntax->print_register) {
            size = syntax->print_register(syntax->user, number, at, X86_FORMAT_HOOK);
            at   = x86_put_hook(at, size);
         }

         if (!size) {
            at = x86_put_register(at, syntax, number, 1);
         }
      } else if (kind <= X86_TOKEN_STRING) {
         at = x86_put(at, mark);
         if (UNLIKELY(flags & X86_TOKEN_STAR)) {
            at = x86_put(at, &syntax->indirect_mark);
         }

         if (careful) {
            at = x86_put_hooked(at, syntax, bytes, view, code, next);
         } else {
            at = x86_put_address(at, syntax, bytes, view, code, next, 0);
         }

         if (syntax->sizes == NYASM_X86_SIZES_TYPES) {
            kept = X86_TOKEN_TYPE(code) && X86_TOKEN_TYPE(code) != X86_ROW_TYPE(second);
            at   = x86_put_if(at, &syntax->type_mark, kept);
            at   = x86_put_if(at, x86_format_types + X86_TOKEN_TYPE(code), kept);
         }
      } else if (kind <= X86_TOKEN_ONE) {
         value = x86_view_immediate(bytes, view, X86_TOKEN_EXTRA(code));
         bits  = X86_TOKEN_BASE(code);
         if (UNLIKELY(kind == X86_TOKEN_ONE)) {
            value = 1;
         }

         if (UNLIKELY(flags & X86_TOKEN_NIBBLE)) {
            value &= 15;
         }

         sign     = 1ull << ((bits - 1) & 63);
         extended = ((value & ((sign << 1) - 1)) ^ sign) - sign;
         minus    = (flags & X86_TOKEN_SIGNED) != 0;
         value    = X86_CHOOSE(value, extended, minus);
         minus   &= (u32)(value >> 63);
         at       = x86_put(at, mark);
         size     = 0;
         if (careful && syntax->print_immediate) {
            size = syntax->print_immediate(syntax->user, value, bits, at, X86_FORMAT_HOOK);
            at   = x86_put_hook(at, size);
         }

         if (!size) {
            at = x86_put(at, &syntax->immediate_mark);
            at = x86_put_signed(at, syntax, (value ^ (0 - (u64)minus)) + minus, minus);
         }
      } else if (kind == X86_TOKEN_RELATIVE) {
         value = x86_view_immediate(bytes, view, X86_TOKEN_EXTRA(code));
         sign  = 1ull << ((X86_TOKEN_BASE(code) - 1) & 63);
         value = ((value & ((sign << 1) - 1)) ^ sign) - sign + next;
         sign  = 1ull << ((X86_VIEW_SIZE(view) - 1) & 63);
         at    = x86_put(at, mark);
         at    = x86_put_target(at, syntax, value & ((sign << 1) - 1), careful);
      } else if (kind == X86_TOKEN_ABSOLUTE) {
         at = x86_put(at, mark);
         at = x86_put_target(at, syntax, x86_view_immediate(bytes, view, X86_TOKEN_EXTRA(code)), careful);
      } else if (kind == X86_TOKEN_FAR) {
         at = x86_put(at, mark);
         at = x86_put(at, &syntax->immediate_mark);
         at = x86_put_number(at, syntax, x86_view_immediate(bytes, view, X86_TOKEN_EXTRA(code)));
         at = x86_put(at, &syntax->far_mark);
         at = x86_put(at, &syntax->immediate_mark);
         at = x86_put_number(at, syntax, x86_view_immediate(bytes, view, X86_TOKEN_NUMBER(code)));
      } else {
         made = x86_put_rounding(at, mark, view, code);
         if (!made) {
            continue;
         }

         at = made;
      }

      mark = &syntax->separator;
      if (UNLIKELY(flags & X86_TOKEN_MASK)) {
         at = x86_put_mask(at, syntax, view);
      }
   }

   *at = 0;
   return (u32)(at - text);
}

static u32 x86_format_plain(const x86_context *context, const u8 *bytes, const x86_view *view, u64 address,
                            const nyasm_x86_syntax *syntax, char *text) {
   return x86_format_line(context, bytes, view, address, syntax, text, 0);
}

static TEXT_APART u32 x86_format_careful(const x86_context *context, const u8 *bytes, const x86_view *view,
                                         u64 address, const nyasm_x86_syntax *syntax, char *text, u32 capacity) {
   char line[X86_FORMAT_FULL];
   u32  size;
   u32  index;

   if (X86_HOOKED(syntax)) {
      size = x86_format_line(context, bytes, view, address, syntax, line, 1);
   } else {
      size = x86_format_plain(context, bytes, view, address, syntax, line);
   }

   for (index = 0; index + 1 < capacity && index < size; ++index) {
      text[index] = line[index];
   }

   if (capacity) {
      text[index] = 0;
   }

   return size;
}

static u32 x86_format_usual(const x86_context *context, const u8 *bytes, const x86_view *view, u64 address,
                            char *text) {
   return x86_format_line(context, bytes, view, address, X86_DEFAULT_SYNTAX, text, 0);
}

static u32 x86_format_given(const x86_context *context, const u8 *bytes, const x86_view *view, u64 address,
                            const nyasm_x86_syntax *syntax, char *text, u32 capacity) {
   if (X86_USUAL(syntax, capacity)) {
      return x86_format_usual(context, bytes, view, address, text);
   }

   if (!syntax) {
      syntax = X86_DEFAULT_SYNTAX;
   }

   if (capacity < NYASM_X86_TEXT || X86_HOOKED(syntax)) {
      return x86_format_careful(context, bytes, view, address, syntax, text, capacity);
   }

   return x86_format_plain(context, bytes, view, address, syntax, text);
}

static TEXT_APART u32 x86_format_other(const x86_context *context, const nyasm_instruction *found, u64 address,
                                       const nyasm_x86_syntax *syntax, char *text, u32 capacity) {
   x86_view view;

   view.length = 0;
   if (context->fast) {
      view = x86_view_quick(found->bytes, context->custom);
      if (!view.length && !x86_view_extended(found->bytes, context->custom, &view)) {
         x86_view_general(found->bytes, context->custom, &view);
      }
   }

   if (!view.length || view.handle != found->handle || view.length != found->length) {
      view = x86_view_full(context, found);
   }

   return x86_format_given(context, found->bytes, &view, address, syntax, text, capacity);
}

static u32 x86_format(const x86_context *context, const nyasm_instruction *found, u64 address,
                      const nyasm_x86_syntax *syntax, char *text, u32 capacity) {
   x86_view view;

   if (LIKELY(context->fast && X86_USUAL(syntax, capacity))) {
      view = x86_view_quick(found->bytes, context->custom);
      if (UNLIKELY(!view.length)) {
         x86_view_extended(found->bytes, context->custom, &view);
      }

      if (LIKELY(view.length && view.handle == found->handle && view.length == found->length)) {
         return x86_format_line(context, found->bytes, &view, address, X86_DEFAULT_SYNTAX, text, 0);
      }
   }

   return x86_format_other(context, found, address, syntax, text, capacity);
}

static TEXT_APART u32 x86_disassemble_other(const x86_context *context, const u8 *bytes, u32 size, u64 address,
                                            const nyasm_x86_syntax *syntax, char *text, u32 capacity, u32 tried) {
   nyasm_instruction found;
   x86_view          view;

   view.length = 0;
   if (context->fast && size >= NYASM_BYTES) {
      if (!tried && !x86_view_extended(bytes, context->custom, &view)) {
         view = x86_view_quick(bytes, context->custom);
      }

      if (view.length || x86_view_general(bytes, context->custom, &view)) {
         x86_format_given(context, bytes, &view, address, syntax, text, capacity);
         return view.length;
      }
   }

   x86_decode(context, bytes, size, &found);
   x86_format_other(context, &found, address, syntax, text, capacity);
   return found.length;
}

static TEXT_APART u32 x86_disassemble_extended(const x86_context *context, const u8 *bytes, u32 size, u64 address,
                                               char *text) {
   x86_view view;

   if (x86_view_extended(bytes, context->custom, &view)) {
      x86_format_usual(context, bytes, &view, address, text);
      return view.length;
   }

   return x86_disassemble_other(context, bytes, size, address, X86_DEFAULT_SYNTAX, text, NYASM_X86_TEXT,
                                1);
}

static u32 x86_disassemble(const x86_context *context, const u8 *bytes, u32 size, u64 address,
                           const nyasm_x86_syntax *syntax, char *text, u32 capacity) {
   x86_view view;

   if (LIKELY(context->fast && size >= NYASM_BYTES && X86_USUAL(syntax, capacity))) {
      if (UNLIKELY(x86_hot.fast_rows[bytes[0]].flags & X86_FAST_EXTENDED)) {
         return x86_disassemble_extended(context, bytes, size, address, text);
      }

      view = x86_view_quick(bytes, context->custom);
      if (LIKELY(view.length)) {
         x86_format_line(context, bytes, &view, address, X86_DEFAULT_SYNTAX, text, 0);
         return view.length;
      }

      return x86_disassemble_other(context, bytes, size, address, syntax, text, capacity, 1);
   }

   return x86_disassemble_other(context, bytes, size, address, syntax, text, capacity, 0);
}
