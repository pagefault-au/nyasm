      x86_read_unit(values, X86_UNIT_REX, parts->payload[0]);
   }

   x86_set_field(values, X86_FIELD_SPACE, escape->space);
   for (index = 0; index < escape->units; ++index) {
      x86_read_unit(values, units[index], parts->payload[index]);
   }

   for (index = 0; index < escape->set_count; ++index) {
      x86_set_field(values, x86_escape_sets[escape->sets + index].field,
                    x86_escape_sets[escape->sets + index].value);
   }

