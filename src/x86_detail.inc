   x86_escape_units(escape, units);
   x86_set_field(values, X86_FIELD_OSZ, prefixes & 1);
   x86_set_field(values, X86_FIELD_ASZ, prefixes >> 1 & 1);
   x86_set_field(values, X86_FIELD_LOCK, prefixes >> 2 & 1);
   x86_set_field(values, X86_FIELD_REP, repeat);
   x86_set_field(values, X86_FIELD_EASZ, x86_size_codes[parts->address_size] - 1);
   x86_set_field(values, X86_FIELD_REX, (parts->flags & NYASM_X86_DETAIL_REX) != 0);
   x86_set_field(values, X86_FIELD_PP, repeat);
   if (prefixes & 1) {
      x86_set_field(values, X86_FIELD_PP, 1);
   }

