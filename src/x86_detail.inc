   operand->width       = rows[index].width;
   operand->kind        = rows[index].kind;
   operand->visibility  = rows[index].visibility;
   operand->access      = rows[index].access;
   operand->flags       = rows[index].flags;
   if (rows[index].family) {
      family = x86_operand_families + rows[index].family - 1;
