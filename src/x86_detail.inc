      operand->memory.address_size = parts->address_size;
      if (family && family->address == X86_ADDRESS_MOFFS) {
         operand->memory.displacement = (i64)slots[X86_SLOT_OFFSET];
      } else if (family && (family->address == X86_ADDRESS_MODRM || family->address == X86_ADDRESS_VSIB)) {
         operand->memory.displacement = address.displacement;
         operand->memory.scale        = address.scale;
