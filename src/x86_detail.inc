      operand->immediate = 15u ^ values->value[X86_FIELD_VVVV];
   } else if (operand->kind == NYASM_OPERAND_IMMEDIATE && family && family->immediate == X86_IMMEDIATE_ONE) {
      operand->immediate = 1;
   } else if (operand->kind == NYASM_OPERAND_IMMEDIATE) {
      if (family && family->source == X86_SOURCE_IMM2) {
         slot = X86_SLOT_IMMEDIATE2;
      }

      operand->immediate = slots[slot];
      if (nibble) {
         operand->immediate &= 15;
      }
   } else if (operand->kind == NYASM_OPERAND_RELATIVE && family && family->kind == X86_KIND_ABSBR) {
      operand->immediate = slots[X86_SLOT_RELATIVE];
   } else if (operand->kind == NYASM_OPERAND_RELATIVE) {
      slot               = x86_immediate_width(x86_attributes_of(parts)->relative, parts->operand_size);
      operand->immediate = (u64)x86_sign_extend(slots[X86_SLOT_RELATIVE], slot);
   } else if (operand->kind == NYASM_OPERAND_POINTER) {
      operand->selector  = (u16)slots[X86_SLOT_IMMEDIATE];
      operand->immediate = slots[X86_SLOT_RELATIVE];
   }

   return 1;
}

static u32 x86_operand_of(const x86_context *context, const nyasm_instruction *found, u32 index,
                          nyasm_x86_operand *operand) {
   nyasm_x86_detail parts;
   x86_fields       values;

   if (!found->handle || !x86_decode_detail(context, found, &parts)) {
      return 0;
   }

   x86_decode_fields(context, &parts, &values);
   return x86_operand(&parts, &values, index, operand);
}
