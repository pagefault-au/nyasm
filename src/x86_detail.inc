      for (next = index + 1; next < count && (rows[next].flags & X86_ROW_FLAG_PART); ++next) {
         source = rows[next].source - 1u;
         if (source == X86_SOURCE_BASE) {
            operand->memory.base = rows[next].register_id;
         } else if (source == X86_SOURCE_INDEX) {
            operand->memory.index = rows[next].register_id;
         } else if (source == X86_SOURCE_SEGMENT) {
            operand->memory.segment = rows[next].register_id;
         }
