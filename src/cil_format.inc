static u32 cil_format(const cil_context *context UNUSED, const cil_instruction *found, u64 address, char *text,
                      u32 capacity) {
   text_output out;
   cil_view    view;
   u32         kept = found->length;

   text_start(&out, text, capacity);
   if (!cil_record(found, &view)) {
      put_text(&out, "(bad)");
      return text_end(&out);
   }

   if (kept > NYASM_BYTES) {
      kept = NYASM_BYTES;
   }

   cil_print(&out, found->bytes, kept, &view, address);
   return text_end(&out);
}

static u32 cil_disassemble(const cil_context *context UNUSED, const u8 *bytes, u32 size, u64 address, char *text,
                           u32 capacity) {
   text_output out;
   cil_view    view;

   text_start(&out, text, capacity);
   if (!cil_view_of(bytes, size, 1, &view)) {
      put_text(&out, "(bad)");
      text_end(&out);
      return 0;
   }

   cil_print(&out, bytes, size, &view, address);
   text_end(&out);
   return (u32)view.length;
}
