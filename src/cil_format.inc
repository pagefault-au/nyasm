      return;
   }

   put_character(out, ' ');
   switch (operand) {
      case NYASM_CIL_OPERAND_INT8:
      case NYASM_CIL_OPERAND_INT32:
      case NYASM_CIL_OPERAND_INT64:
         put_signed(out, (i64)view->value);
         break;
      case NYASM_CIL_OPERAND_FLOAT32:
         cil_put_float(out, view->value, CIL_SINGLE);
         break;
      case NYASM_CIL_OPERAND_FLOAT64:
         cil_put_float(out, view->value, CIL_DOUBLE);
         break;
      case NYASM_CIL_OPERAND_SHORT_BRANCH:
      case NYASM_CIL_OPERAND_BRANCH:
         cil_put_label(out, next + view->value);
         break;
      case NYASM_CIL_OPERAND_SHORT_VARIABLE:
      case NYASM_CIL_OPERAND_VARIABLE:
         put_decimal(out, view->value);
         break;
      case NYASM_CIL_OPERAND_SWITCH:
         cil_put_switch(out, bytes, size, view, next);
         break;
      default:
         put_text(out, "0x");
         put_hex(out, view->value, CIL_TOKEN_DIGITS);
         break;
   }
