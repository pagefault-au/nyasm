      put_character(&render->out, ' ');
   }

   render->out.pending = 0;
   return 1;
}

static void riscv64_put(riscv64_renderer *render, char character) {
   if (render->quiet) {
      return;
   }

   if (character == ' ') {
      render->out.pending = 1;
      return;
   }

   riscv64_open(render, character);
   put_character(&render->out, character);
}

static void riscv64_put_text(riscv64_renderer *render, const char *text, u32 lower) {
