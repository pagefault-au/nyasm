   while (*text) {
      character = *text;
      if (lower && character >= 'A' && character <= 'Z') {
         character += 'a' - 'A';
      }

      riscv64_put(render, character);
      text += 1;
   }
}

static void riscv64_put_signed(riscv64_renderer *render, u64 value) {
   if (riscv64_open(render, '0')) {
      put_signed(&render->out, (i64)value);
   }
}

static void riscv64_put_decimal(riscv64_renderer *render, u64 value) {
   if (riscv64_open(render, '0')) {
      put_decimal(&render->out, value);
   }
}

static void riscv64_put_hex(riscv64_renderer *render, u64 value) {
   if (!riscv64_open(render, '0')) {
      return;
   }

   put_character(&render->out, '0');
   put_character(&render->out, 'x');
   put_hex(&render->out, value, 1);
}

static void riscv64_row(riscv64_renderer *render) {
   const u8   *code  = riscv64_code;
   const char *texts[2];
   u32         kind  = code[render->at];
   u32         stack = 0;
   u32         count;

   render->at += 1;
   if (kind == RISCV64_ROW_TEXT) {
      riscv64_put_text(render, riscv64_template_string(render), 0);
   }

   if (kind == RISCV64_ROW_HASH) {
      riscv64_put(render, '#');
   }

   if (kind == RISCV64_ROW_NUMBER || kind == RISCV64_ROW_HASH) {
      riscv64_put_signed(render, riscv64_expression(render));
   }

   if (kind == RISCV64_ROW_STACK) {
      texts[1]    = riscv64_template_string(render);
      texts[0]    = riscv64_template_string(render);
      count       = code[render->at];
      render->at += 1;
      while (count) {
         stack |= riscv64_expression(render) == 31;
         count -= 1;
      }

      riscv64_put_text(render, texts[stack], 0);
   }
}

static void riscv64_print_text(riscv64_renderer *render) {
   riscv64_put_text(render, riscv64_template_string(render), 1);
}

static void riscv64_print_register(riscv64_renderer *render) {
   const char *prefix = riscv64_template_string(render);
   const char *last   = riscv64_template_string(render);
   u64         value  = riscv64_expression(render);

   if (value == 31 && *last) {
      riscv64_put_text(render, last, 0);
      return;
   }

   riscv64_put_text(render, prefix, 0);
   riscv64_put_decimal(render, value);
}

static void riscv64_print_immediate(riscv64_renderer *render) {
   u32 plain = riscv64_code[render->at];
   u64 value;

   render->at += 1;
   value       = riscv64_expression(render);
   if (plain == RISCV64_IMMEDIATE_HEX) {
      riscv64_put_hex(render, value);
      return;
   }

   if (plain == RISCV64_IMMEDIATE_UNSIGNED) {
      riscv64_put_decimal(render, value);
      return;
   }

   riscv64_put_signed(render, value);
}

static void riscv64_print_float(riscv64_renderer *render) {
   u64 packed = riscv64_expression(render);
   u32 shift  = 7 - ((packed >> 4 & 7) ^ 4);
   u64 whole  = 16 + (packed & 15);
   u64 rest   = whole & riscv64_ones(shift);

   if (packed >> 7 & 1) {
      riscv64_put(render, '-');
   }

   riscv64_put_decimal(render, whole >> shift);
   riscv64_put(render, '.');
   do {
      rest *= 10;
      riscv64_put(render, (char)('0' + (rest >> shift)));
      rest &= riscv64_ones(shift);
   } while (rest);
}

static void riscv64_print_label(riscv64_renderer *render) {
   riscv64_put(render, '#');
   riscv64_put_signed(render, riscv64_expression(render));
}

static void riscv64_print_mask(riscv64_renderer *render) {
   u32 wide = riscv64_code[render->at];
   u32 size;
   u64 mask;

   render->at += 1;
   mask        = riscv64_bit_mask(riscv64_expression(render), &size);
   if (wide == 0) {
      mask &= 0xFFFFFFFF;
   }

   if (wide == 2) {
      mask &= riscv64_ones(size);
   }

   riscv64_put_decimal(render, mask);
}

static void riscv64_print_alternative(riscv64_renderer *render) {
   u64 wanted = riscv64_number(render);
   u32 other  = riscv64_expression(render) != wanted;

   render->quiet += other;
   riscv64_item(render);
   render->quiet -= other;
   render->quiet += !other;
   riscv64_item(render);
   render->quiet -= !other;
}

static void riscv64_print_table(riscv64_renderer *render) {
   const u8 *code      = riscv64_code;
   u32       fallback  = code[render->at];
   u64       otherwise = 0;
   u32       matched   = 0;
   u64       key;
   u64       mask;
   u64       value;
   u32       count;
   u32       skip;

   render->at += 1;
   if (fallback) {
      otherwise = riscv64_expression(render);
   }

   key         = riscv64_expression(render);
   count       = code[render->at];
   render->at += 1;
   while (count) {
      mask           = riscv64_number(render);
      value          = riscv64_number(render);
      skip           = matched || (key & mask) != value;
      render->quiet += skip;
      riscv64_row(render);
      render->quiet -= skip;
      matched       |= !skip;
      count         -= 1;
   }

   if (!matched && fallback) {
      riscv64_put(render, '#');
      riscv64_put_signed(render, otherwise);
   }
}

static void riscv64_print_optional(riscv64_renderer *render) {
   u32 hidden = !riscv64_expression(render);

   render->quiet += hidden;
   riscv64_items(render);
   render->quiet -= hidden;
}

static void riscv64_put_named(riscv64_renderer *render, u32 class, u64 value) {
   const riscv64_class *row = riscv64_class_rows + class;
   u32               index;

   for (index = 0; index < row->count; ++index) {
      if (riscv64_class_names[row->first + index].number == value) {
         riscv64_put_text(render, riscv64_string(riscv64_class_names[row->first + index].text), 0);
         return;
      }
   }

   riscv64_put_text(render, riscv64_string(row->prefix), 0);
   riscv64_put_decimal(render, value);
}

static void riscv64_print_named(riscv64_renderer *render) {
   u32 class = (u32)riscv64_number(render);

   riscv64_put_named(render, class, riscv64_expression(render));
}

static void riscv64_print_list(riscv64_renderer *render) {
   u32 class = (u32)riscv64_number(render);
   u64 mask  = riscv64_expression(render);
   u32 first = 1;
   u32 bit;

   for (bit = 0; bit < BITS_OF(mask); ++bit) {
      if (mask >> bit & 1) {
         if (!first) {
            riscv64_put(render, ',');
            riscv64_put(render, ' ');
         }

         riscv64_put_named(render, class, bit);
         first = 0;
      }
   }
}

static const riscv64_item_printer riscv64_printers[RISCV64_ITEM_COUNT] = {
   [RISCV64_ITEM_TEXT]        = riscv64_print_text,
   [RISCV64_ITEM_REGISTER]    = riscv64_print_register,
   [RISCV64_ITEM_IMMEDIATE]   = riscv64_print_immediate,
   [RISCV64_ITEM_FLOAT]       = riscv64_print_float,
   [RISCV64_ITEM_LABEL]       = riscv64_print_label,
   [RISCV64_ITEM_MASK]        = riscv64_print_mask,
   [RISCV64_ITEM_ALTERNATIVE] = riscv64_print_alternative,
   [RISCV64_ITEM_TABLE]       = riscv64_print_table,
   [RISCV64_ITEM_OPTIONAL]    = riscv64_print_optional,
   [RISCV64_ITEM_NAMED]       = riscv64_print_named,
   [RISCV64_ITEM_LIST]        = riscv64_print_list,
};

static void riscv64_item(riscv64_renderer *render) {
   u32 kind = riscv64_code[render->at];

   render->at += 1;
   riscv64_printers[kind](render);
}

static void riscv64_items(riscv64_renderer *render) {
   while (riscv64_code[render->at] != RISCV64_ITEM_END) {
      riscv64_item(render);
   }

   render->at += 1;
}

static u32 riscv64_format(const riscv64_context *context, const riscv64_instruction *found, u64 address UNUSED,
                       char *text, u32 capacity) {
   const word_aliases_row *alias;
   riscv64_renderer           render;
   riscv64_detail             detail;
   u32                     aliases = 1;
   u32                     at;
   u32                     index;

   render.quiet = 0;
   render.state = found->bytes[RISCV64_STATE_AT];
   text_start(&render.out, text, capacity);
   if (!riscv64_decode_detail(context, found, &detail)) {
      put_text(&render.out, "(bad)");
      return text_end(&render.out);
   }

   aliases = !(context->flags & RISCV64_NO_ALIASES);

   render.encoding = riscv64_encodings + detail.encoding;
   at              = riscv64_templates[render.encoding->template_];
   for (index = 0; index < detail.field_count; ++index) {
      render.values[index] = detail.fields[index];
   }

   index = riscv64_alias_firsts[detail.encoding];
   for (; aliases && index < riscv64_alias_firsts[detail.encoding + 1]; ++index) {
      alias     = riscv64_aliases + index;
      render.at = alias->condition;
      if ((detail.word & alias->mask) == alias->value && riscv64_expression(&render)) {
         at = alias->template_;
         break;
      }
   }

   render.at = at;
   riscv64_items(&render);
   return text_end(&render.out);
}

static u32 riscv64_disassemble(const riscv64_context *context, const u8 *bytes, u32 size, u64 address, char *text,
                            u32 capacity) {
   riscv64_instruction found;
   u32              length = riscv64_decode(context, bytes, size, &found);

   riscv64_format(context, &found, address, text, capacity);
   return length;
}
