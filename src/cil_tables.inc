static u32 cil_mnemonic(u32 handle) {
   if (handle >= COUNT_OF(cil_iform_mnemonics)) {
      return 0;
   }

   return cil_iform_mnemonics[handle];
}

#if NYASM_FORMAT || NYASM_METADATA || NYASM_UIR

static const char *cil_string(u32 string) {
   return (const char *)cil_strings + cil_string_offsets[string];
}

#endif

#if NYASM_UIR

static const char *cil_uir_name(u32 name) {
   if (name >= COUNT_OF(cil_uir_names)) {
      return "";
   }

   return cil_string(name);
}

#endif

