static u32 term_given_make(nyasm_terms *terms, u32 operation, u32 width, u32 a, u32 b, u32 c, u64 value) {
   if (operation > NYASM_TERM_MEMORY || a >= terms->count || b >= terms->count || c >= terms->count) {
      return 0;
   }

   return term_make(terms, operation, width, a, b, c, value);
}

static u32 term_given_resize(nyasm_terms *terms, u32 term, u32 width) {
   if (!term || term >= terms->count) {
      return 0;
   }

   return term_resize(terms, term, width);
}
