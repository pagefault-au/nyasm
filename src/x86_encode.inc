      list = x86_operand_lists + span->first + index;
      if (!list->family) {
         continue;
      }

      family = x86_operand_families + list->family - 1;
      if (family->address == X86_ADDRESS_MODRM || family->address == X86_ADDRESS_VSIB) {
         return 1;
      }
   }

   return 0;
}

static u32 x86_request_register(x86_request *request, u32 operand, u32 register_id) {
   const x86_operands_row *family;
   const operand_rows_row *row    = x86_request_row(request, operand, &family);
   const x86_classes_row  *item   = 0;
   u32                     vector = 0;
   u32                     first;
   u32                     space;
   u32                     source;
   u32                     number;
   u32                     field;
   u32                     value;
   u32                     index;

   if (!row || row->kind != NYASM_OPERAND_REGISTER || !row->register_) {
      return 0;
   }

   if (!row->source || row->source - 1u >= X86_SOURCE_BASE) {
      return register_id == row->register_;
   }

   first  = x86_handle_firsts[request->handle];
   space  = x86_encoding_opcodes[x86_handle_encodings[first]].space;
   source = row->source - 1u;
   if (source == X86_SOURCE_MODRM_RM && x86_request_addressed(request)) {
      return 1;
   }

   number = register_id - row->register_;
   if (family && family->class_) {
      item   = x86_classes + family->class_ - 1;
      vector = space == X86_SPACE_EVEX && item->bank >= X86_BANK_XMM && item->bank <= X86_BANK_ZMM;
   }

   if (item && item->special == X86_SPECIAL_HIGH8 && number >= 32) {
      number -= 28;
   } else if (item && item->special == X86_SPECIAL_HIGH8 && number >= 4 && number < 8) {
      x86_set_field(&request->fields, X86_FIELD_REX, 1);
   }

   first = (2 * source + vector) * 3;
   if (x86_source_fields[first] == X86_NO_REGISTER) {
      request->immediates[X86_SLOT_IMMEDIATE] |= (u64)(number & 15) << 4;
      return 1;
   }

   for (index = 0; index < 3; ++index) {
      field = x86_source_fields[first + index];
      if (field != X86_NO_REGISTER) {
         value = number >> x86_source_shifts[first + index] & (x86_field_rows[field].count - 1u);
         x86_request_field(request, field, value);
      }
   }

   if (source == X86_SOURCE_MODRM_RM) {
      x86_request_field(request, X86_FIELD_MOD, 3);
   }

   return 1;
}

static u32 x86_address_register(u32 register_id, u32 *bits) {
   u32 size;

   for (size = 16; size <= 64; size *= 2) {
      if (register_id >= x86_gpr_base(size) && register_id < x86_gpr_base(size) + 32) {
         *bits = size;
         return register_id - x86_gpr_base(size);
      }
   }

   if (register_id == NYASM_X86_REGISTER_RIP) {
      *bits = 64;
      return X86_RIP;
   }

   if (register_id == NYASM_X86_REGISTER_EIP) {
      *bits = 32;
      return X86_RIP;
   }

   return X86_NO_REGISTER;
}

static u32 x86_request_memory(x86_request *request, u32 operand, const nyasm_x86_memory *memory) {
   const x86_operands_row   *family;
   const operand_rows_row   *row    = x86_request_row(request, operand, &family);
   const x86_attributes_row *attributes;
   u32                       bits   = memory->address_size;
   u32                       base   = X86_NO_REGISTER;
   u32                       index  = X86_NO_REGISTER;
   u32                       scale  = memory->scale;
   u32                       normal = NYASM_X86_SEGMENT_DS;
   u32                       size   = 0;
   u32                       segment;

   if (!row || !family || (row->kind != NYASM_OPERAND_MEMORY && row->kind != NYASM_OPERAND_ADDRESS)) {
      return 0;
   }

   if (family->address != X86_ADDRESS_MODRM && family->address != X86_ADDRESS_VSIB
       && family->address != X86_ADDRESS_MOFFS) {
      return 0;
   }

   attributes = x86_attributes + x86_encodings[x86_handle_encodings[x86_handle_firsts[request->handle]]].attributes;
   if (memory->base) {
      base = x86_address_register(memory->base, &bits);
      if (base == X86_NO_REGISTER) {
         return 0;
      }
   }

   if (memory->index && (attributes->flags & X86_FLAG_VSIB)) {
      index = memory->index - (u32)x86_bank_bases[attributes->vsib_bank];
   } else if (memory->index) {
      index = x86_address_register(memory->index, &size);
      if (index == X86_NO_INDEX || index == X86_RIP || (memory->base && size != bits)) {
         return 0;
      }

      bits = size;
   }

   if (memory->index && index >= 32) {
      return 0;
   }

   if (base == 4 || base == 5) {
      normal = NYASM_X86_SEGMENT_SS;
   }

   for (segment = 1; segment < COUNT_OF(x86_segment_registers); ++segment) {
      if (memory->segment && x86_segment_registers[segment] == memory->segment && segment != normal) {
         request->segment = (u8)segment;
      }
   }

   if (!scale) {
      scale = 1;
   }

   if (bits) {
      request->address_size = (u8)bits;
   }

   if (family->address == X86_ADDRESS_MOFFS) {
      request->immediates[X86_SLOT_OFFSET] = (u64)memory->displacement;
      return 1;
   }

   request->displacement = memory->displacement;
   request->base         = (u8)base;
   request->index        = (u8)index;
   request->scale        = (u8)scale;
   request->has_memory   = 1;
   return 1;
}

static u32 x86_request_nibble(const x86_request *request) {
   const iform_operands_row *span = x86_iform_operands + request->handle;
   const operand_lists_row  *list;
   u32                       index;

   for (index = 0; index < span->count; ++index) {
      list = x86_operand_lists + span->first + index;
      if (list->family && x86_operand_families[list->family - 1].source == X86_SOURCE_IMM8_7_4) {
         return 1;
      }
   }

   return 0;
}

static u32 x86_request_immediate(x86_request *request, u32 operand, u64 value) {
   const x86_operands_row *family;
   const operand_rows_row *row  = x86_request_row(request, operand, &family);
   u32                     slot = X86_SLOT_IMMEDIATE;

   if (!row || (row->kind != NYASM_OPERAND_IMMEDIATE && row->kind != NYASM_OPERAND_RELATIVE)) {
      return 0;
   }

   if (row->kind == NYASM_OPERAND_RELATIVE) {
      request->immediates[X86_SLOT_RELATIVE] = value;
      return 1;
   }

   if (family && family->kind == X86_KIND_DFV) {
      if (value > 15) {
         return 0;
      }

      x86_request_field(request, X86_FIELD_VVVV, 15u ^ (u32)value);
      return 1;
   }

   if (family && family->immediate == X86_IMMEDIATE_ONE) {
      return value == 1;
   }

   if (family && family->source == X86_SOURCE_IMM2) {
      slot = X86_SLOT_IMMEDIATE2;
   }

   if (slot == X86_SLOT_IMMEDIATE && value > 15 && x86_request_nibble(request)) {
      return 0;
   }

   request->immediates[slot] |= value;
   return 1;
}

static u32 x86_request_pointer(x86_request *request, u32 operand, u32 selector, u64 offset) {
   const x86_operands_row *family;
   const operand_rows_row *row = x86_request_row(request, operand, &family);

   if (!row || row->kind != NYASM_OPERAND_POINTER) {
      return 0;
   }

   request->immediates[X86_SLOT_IMMEDIATE] = selector;
   request->immediates[X86_SLOT_RELATIVE]  = offset;
   return 1;
}

static u32 x86_encode_request(const x86_context *context, const x86_request *request,
                              const nyasm_x86_operand *operands, u8 *bytes, u32 *error) {
   const x86_escape          *escape;
   const x86_encoding_opcode *opcode;
   u8                         made[X86_SCRATCH];
   u32                        handle = request->handle;
   u32                        member;
   u32                        encoding;
   u32                        number;
   u32                        choice;
   u32                        length;
   u32                        index;

   *error = NYASM_ERROR_OPERAND;
   if (handle >= X86_HANDLE_COUNT) {
      return 0;
   }

   for (member = x86_handle_firsts[handle]; member < x86_handle_firsts[handle + 1]; ++member) {
      encoding = x86_handle_encodings[member];
      opcode   = x86_encoding_opcodes + encoding;
      for (number = 0; number < NYASM_X86_ESCAPE_COUNT; ++number) {
         escape = x86_escapes + number;
         if (escape->space != opcode->space || !(escape->modes >> context->mode & 1)) {
            continue;
         }

         if (escape->map_unit == X86_NO_REGISTER && escape->map != opcode->map) {
            continue;
         }

         if (escape->map_unit != X86_NO_REGISTER && opcode->map > escape->map_mask) {
            continue;
         }

         for (choice = 0; choice < X86_PREFIX_CHOICES; ++choice) {
            for (index = 0; index < X86_SCRATCH; ++index) {
               made[index] = 0;
            }

            length = x86_try_encoding(context, request, encoding, number, x86_prefix_choices + choice, made);
            if (length && length <= NYASM_X86_MAX_LENGTH && x86_verify(context, request, operands, made, length)) {
               for (index = 0; index < length; ++index) {
                  bytes[index] = made[index];
               }

               *error = NYASM_ERROR_NONE;
               return length;
            }
         }
      }
   }

   return 0;
}

static nyasm_x86_operand x86_blank_op(u32 kind) {
   nyasm_x86_operand operand;
   u32               index;

   operand.memory.displacement = 0;
   operand.memory.base         = 0;
   operand.memory.index        = 0;
   operand.memory.segment      = 0;
   operand.memory.scale        = 1;
   operand.memory.address_size = 0;
   operand.immediate           = 0;
   operand.register_id         = 0;
   operand.selector            = 0;
   operand.width               = 0;
   operand.kind                = (u8)kind;
   operand.visibility          = 0;
   operand.access              = 0;
   operand.flags               = 0;
   for (index = 0; index < COUNT_OF(operand.reserved); ++index) {
      operand.reserved[index] = 0;
   }

   return operand;
}

static nyasm_x86_operand x86_register_operand(u32 register_id) {
   nyasm_x86_operand operand = x86_blank_op(NYASM_OPERAND_REGISTER);

   operand.register_id = (u16)register_id;
   return operand;
}

static nyasm_x86_operand x86_memory_operand(u32 base, u32 index, u32 scale, i64 displacement) {
   nyasm_x86_operand operand = x86_blank_op(NYASM_OPERAND_MEMORY);

   operand.memory.base         = (u16)base;
   operand.memory.index        = (u16)index;
   operand.memory.scale        = (u8)scale;
   operand.memory.displacement = displacement;
   return operand;
}

static nyasm_x86_operand x86_immediate_operand(u64 value) {
   nyasm_x86_operand operand = x86_blank_op(NYASM_OPERAND_IMMEDIATE);

   operand.immediate = value;
   return operand;
}

static nyasm_x86_operand x86_far_operand(u32 selector, u64 offset) {
   nyasm_x86_operand operand = x86_blank_op(NYASM_OPERAND_POINTER);

   operand.selector  = (u16)selector;
   operand.immediate = offset;
   return operand;
}

static void x86_request_implied(x86_request *request, u32 field) {
   const x86_fields_row *row    = x86_field_rows + field;
   u32                   needed = 0;
   u32                   first  = 0;
   u32                   implicant;
   u32                   member;
   u32                   value;

   if (request->given >> field & 1) {
      return;
   }

   for (member = x86_handle_firsts[request->handle]; member < x86_handle_firsts[request->handle + 1]; ++member) {
      implicant = x86_encodings[x86_handle_encodings[member]].implicant;
      if (x86_implicant_bit(implicant, row->offset)) {
         return;
      }

      for (value = row->count; value > 1 && !first; --value) {
         if (x86_implicant_bit(implicant, row->offset + value - 1)) {
            needed = value - 1;
         }
      }

      first = needed;
   }

   if (needed) {
      x86_request_field(request, field, needed);
   }
}

static u32 x86_handle_layout(u32 handle) {
   const x86_variants_row *row;
   u32                     variant;

   if (x86_handle_firsts[handle] == x86_handle_firsts[handle + 1]) {
      return 0;
   }

   variant = x86_encodings[x86_handle_encodings[x86_handle_firsts[handle]]].variant;
   if (variant == X86_NO_VARIANT) {
      return 0;
   }

   row = x86_variants + variant;
   if (handle < row->first_handle || handle - row->first_handle >= row->layout_count) {
      return 0;
   }

   return x86_layouts[row->layouts + handle - row->first_handle];
}

static u32 x86_encode(const x86_context *context, u32 handle, const nyasm_x86_operand *operands, u32 count,
                      const nyasm_x86_encode_options *options, u8 *bytes, u32 *error) {
   const iform_operands_row *span;
   const operand_rows_row   *row;
   x86_request               request;
   u32                       given = 0;
   u32                       layout;
   u32                       taken;
   u32                       index;
   u32                       kind;

   if (!handle || handle >= X86_HANDLE_COUNT) {
      *error = NYASM_ERROR_OPERAND;
      return 0;
   }

   span   = x86_iform_operands + handle;
   *error = NYASM_ERROR_OPERAND;
   x86_request_init(context, handle, &request);
   for (index = 0; index < span->count; ++index) {
      row = x86_operand_rows + x86_operand_lists[span->first + index].row;
      if (!(row->flags & X86_ROW_FLAG_PART) && row->visibility != NYASM_VISIBILITY_SUPPRESSED) {
         if (given == count) {
            return 0;
         }

         taken = 0;
         kind  = operands[given].kind;
         if (kind == NYASM_OPERAND_REGISTER) {
            taken = x86_request_register(&request, index, operands[given].register_id);
         } else if (kind == NYASM_OPERAND_MEMORY || kind == NYASM_OPERAND_ADDRESS) {
            taken = x86_request_memory(&request, index, &operands[given].memory);
         } else if (kind == NYASM_OPERAND_IMMEDIATE || kind == NYASM_OPERAND_RELATIVE) {
            taken = x86_request_immediate(&request, index, operands[given].immediate);
         } else if (kind == NYASM_OPERAND_POINTER) {
            taken = x86_request_pointer(&request, index, operands[given].selector, operands[given].immediate);
         }

         if (!taken) {
            return 0;
         }

         ++given;
      }
   }

   if (given != count) {
      return 0;
   }

   if (options) {
      if (options->segment) {
         x86_request_segment(&request, options->segment);
      }

      if (options->address_size) {
         x86_request_address_size(&request, options->address_size);
      }

      if (options->lock) {
         x86_request_field(&request, X86_FIELD_LOCK, 1);
      }

      if (options->repeat) {
         x86_request_field(&request, X86_FIELD_REP, options->repeat);
      }

      if (options->zeroing) {
         x86_request_field(&request, X86_FIELD_Z, 1);
      }

      if (options->rounding) {
         x86_request_field(&request, X86_FIELD_EVEX_B, 1);
         x86_request_field(&request, X86_FIELD_VL, options->rounding - 1u);
      }
   }

   layout = x86_handle_layout(handle);
   if (layout >> 4 & 1) {
      x86_request_field(&request, X86_FIELD_EVEX_B, 1);
   }

   if ((layout >> 2 & 3) && !request.address_size) {
      x86_request_address_size(&request, 8u << (layout >> 2 & 3));
   }

   x86_request_implied(&request, X86_FIELD_LOCK);
   x86_request_implied(&request, X86_FIELD_REP);
   return x86_encode_request(context, &request, operands, bytes, error);
}
