         parts.immediate2      = (u16)request->immediates[order[index]];
         parts.immediate2_size = (u8)sizes[order[index]];
         taken                 = 2;
      }
   }

   parts.prefixes   = (u8)(combo->osz | (parts.address_size != mode) << 1 | trial.value[X86_FIELD_LOCK] << 2);
   parts.repeat     = combo->repeat;
   parts.segment    = request->segment;
   parts.escape     = (u8)number;
   parts.opcode     = place->opcode;
   parts.modrm      = (u8)x86_pack_unit(0, trial.value, X86_UNIT_MODRM, memory);
   parts.payload[0] = (u8)(0x40 | x86_pack_unit(0, trial.value, X86_UNIT_REX, memory));
   parts.payload[1] = 0;
   parts.payload[2] = 0;
   parts.flags     |= (u8)(NYASM_X86_DETAIL_REX * rex);
   if (flags & X86_FLAG_REGISTER_OPCODE) {
      parts.opcode = (u8)((place->opcode & 0xF8) | trial.value[X86_FIELD_SRM]);
   }

   for (unit = 0; unit < escape->units; ++unit) {
      parts.payload[unit] = (u8)x86_pack_unit(0, trial.value, units[unit], memory);
      for (index = 0; index < X86_ALIAS_COUNT; ++index) {
