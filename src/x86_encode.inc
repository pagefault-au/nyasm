   x86_fields                 trial;
   nyasm_x86_detail           parts;
   u64                        fixed     = 0;
   u32                        implicant = x86_encodings[encoding].implicant;
   u32                        flags     = row->flags;
   u32                        evex      = escape->space == X86_SPACE_EVEX;
   u32                        mode      = 16u << context->mode;
   u32                        held      = x86_field_carried(escape, X86_FIELD_PP, flags);
   u32                        taken     = 0;
   u32                        units[X86_PAYLOAD_UNITS];
   u32                        sizes[X86_SLOT_COUNT];
   u32                        memory;
   u32                        narrow;
   u32                        size;
   u32                        index;
   u32                        unit;
   u32                        alias;
   u32                        rex;

   if (held && (combo->osz || combo->repeat) && !escape->prefixed) {
      return 0;
   }

   x86_escape_units(escape, units);
   x86_copy_fields(&trial, &request->fields);
   parts.address_size = (u8)mode;
   if (request->address_size) {
      parts.address_size = request->address_size;
   }

   if (((request->given >> X86_FIELD_W & 1) && trial.value[X86_FIELD_W] != combo->w)
       || ((request->given >> X86_FIELD_REP & 1) && trial.value[X86_FIELD_REP] != combo->repeat)) {
      return 0;
   }

   x86_set_field(&trial, X86_FIELD_SPACE, escape->space);
   x86_set_field(&trial, X86_FIELD_MAP, place->map);
   x86_set_field(&trial, X86_FIELD_OSZ, combo->osz);
   x86_set_field(&trial, X86_FIELD_REP, combo->repeat);
   x86_set_field(&trial, X86_FIELD_W, combo->w);
   x86_set_field(&trial, X86_FIELD_ASZ, parts.address_size != mode);
   x86_set_field(&trial, X86_FIELD_EASZ, parts.address_size >> 5);
   fixed = 1ull << X86_FIELD_SPACE | 1ull << X86_FIELD_MAP | 1ull << X86_FIELD_OSZ
           | 1ull << X86_FIELD_REP | 1ull << X86_FIELD_W | 1ull << X86_FIELD_ASZ
           | 1ull << X86_FIELD_EASZ | 1ull << X86_FIELD_MODE | 1ull << X86_FIELD_SSZ
           | 1ull << X86_FIELD_LOCK;
   if (!held) {
      x86_set_field(&trial, X86_FIELD_PP, combo->repeat);
      if (combo->osz) {
         x86_set_field(&trial, X86_FIELD_PP, 1);
      }

      fixed |= 1ull << X86_FIELD_PP;
   }

   if (!x86_complete_fields(request, &trial, escape, implicant, flags, fixed)) {
      return 0;
   }

   memory                  = request->has_memory && (flags & X86_FLAG_MODRM);
   parts.flags             = (u8)(NYASM_X86_DETAIL_LONG_MODE * (context->mode == 2));
   parts.flags            |= (u8)(NYASM_X86_DETAIL_MODRM * ((flags & X86_FLAG_MODRM) != 0));
   parts.sib               = 0;
   parts.displacement      = 0;
   parts.displacement_size = 0;
   if (memory && !x86_encode_memory(request, row, &trial, &parts, encoding, evex)) {
      return 0;
   }

   rex = trial.value[X86_FIELD_REX] || x86_pack_unit(0, trial.value, X86_UNIT_REX, memory);
   rex = rex && !escape->units;
   x86_set_field(&trial, X86_FIELD_REX, rex);
   for (index = 0; index < 3; ++index) {
      if (trial.vector[index] & ~x86_implicant_word(implicant, index)) {
         return 0;
      }
   }

   narrow = combo->osz | x86_narrow(trial.value);

   size                  = X86_WIDTH_OF(row->width_rule, context->mode, narrow, combo->w);
   order                 = x86_slot_sizes(row, size, parts.address_size, sizes);
   parts.immediate       = 0;
   parts.immediate2      = 0;
   parts.immediate_size  = 0;
   parts.immediate2_size = 0;
   for (index = 0; index < X86_SLOT_COUNT; ++index) {
      if (sizes[order[index]] && taken == 0) {
         parts.immediate      = request->immediates[order[index]];
         parts.immediate_size = (u8)sizes[order[index]];
         taken                = 1;
