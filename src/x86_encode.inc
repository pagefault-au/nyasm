            alias               = x86_aliases[index].unit;
            parts.payload[unit] = (u8)x86_pack_unit(parts.payload[unit], trial.value, alias, memory);
         }
      }
   }

   return x86_encode_detail(&parts, bytes);
}

static u32 x86_index_number(u32 index, u32 vsib) {
   if (!vsib && index == X86_NO_INDEX) {
      return X86_NO_REGISTER;
   }

   return index;
}

static u32 x86_fits(u64 wanted, u64 found, u32 bits) {
   u64 mask = (1ull << (bits & (X86_VIEW_WIDE - 1))) - 1;

   if (!bits) {
      return !wanted;
   }

   if (bits >= X86_VIEW_WIDE) {
      return wanted == found;
   }

   return !((wanted ^ found) & mask) && (!(wanted & ~mask) || (u64)x86_sign_extend(wanted, bits) == wanted);
}

static u32 x86_same_registers(const nyasm_x86_detail *parts, const x86_fields *values,
                              const nyasm_x86_operand *operands) {
   nyasm_x86_operand found;
   u32               given = 0;
   u32               index;

   for (index = 0; x86_operand(parts, values, index, &found); ++index) {
      if (!(found.flags & X86_ROW_FLAG_PART) && found.visibility != NYASM_VISIBILITY_SUPPRESSED) {
         if (operands[given].kind == NYASM_OPERAND_REGISTER && found.register_id != operands[given].register_id) {
            return 0;
         }

         ++given;
      }
   }

   return 1;
}

static u32 x86_verify(const x86_context *context, const x86_request *request, const nyasm_x86_operand *operands,
                      const u8 *bytes, u32 length) {
   x86_context       plain;
   nyasm_instruction found;
   nyasm_x86_detail  parts;
   x86_fields        values;
   x86_address       memory;
   u64               slots[X86_SLOT_COUNT];
   u32               sizes[X86_SLOT_COUNT];
   u32               field;
   u32               same;
   u32               vsib;
   u32               index;

   x86_copy_fields(&plain.fields, &context->fields);
   plain.decoding = context->decoding;
   plain.mode     = context->mode;
   plain.stack    = context->stack;
   plain.gate     = 0;
   x86_context_refresh(&plain);
   plain.fast = 0;
   if (x86_decode_full(&plain, bytes, length, &found) != length || found.handle != request->handle
       || !x86_decode_detail(&plain, &found, &parts)) {
      return 0;
   }

   x86_decode_fields(&plain, &parts, &values);
   x86_immediates(&parts, slots);
   x86_slot_sizes(x86_attributes_of(&parts), parts.operand_size, parts.address_size, sizes);
   same = x86_same_registers(&parts, &values, operands);
   vsib = (x86_attributes_of(&parts)->flags & X86_FLAG_VSIB) != 0;
   for (field = 0; field < X86_FIELD_COUNT; ++field) {
      same = same && (!(request->given >> field & 1) || values.value[field] == request->fields.value[field]);
   }

   for (index = 0; index < X86_SLOT_COUNT; ++index) {
      same = same && x86_fits(request->immediates[index], slots[index], sizes[index] * 8);
   }

   if (request->has_memory) {
      same  = same && x86_address_of(&parts, &memory) && memory.base == request->base
              && x86_fits((u64)request->displacement, (u64)memory.displacement, parts.address_size)
              && parts.segment == request->segment;
      index = x86_index_number(memory.index, vsib);
      if (vsib) {
         index = (memory.index & 15u) | (u32)values.value[X86_FIELD_V4] << 4;
      }

      same = same && index == x86_index_number(request->index, vsib);
      same = same && (memory.scale == request->scale || index == X86_NO_REGISTER);
   }

   return same;
}

static void x86_request_init(const x86_context *context, u32 handle, x86_request *request) {
   u32 index;

   x86_copy_fields(&request->fields, &context->fields);
   for (index = 0; index < X86_SLOT_COUNT; ++index) {
      request->immediates[index] = 0;
   }

   request->displacement = 0;
   request->given        = 0;
   request->handle       = (u16)handle;
   request->base         = X86_NO_REGISTER;
   request->index        = X86_NO_REGISTER;
   request->scale        = 1;
   request->has_memory   = 0;
   request->segment      = 0;
   request->address_size = 0;
}

static void x86_request_field(x86_request *request, u32 field, u32 value) {
   x86_set_field(&request->fields, field, value);
   request->given |= 1ull << field;
}

static void x86_request_segment(x86_request *request, u32 segment) {
   request->segment = (u8)segment;
}

static void x86_request_address_size(x86_request *request, u32 bits) {
   request->address_size = (u8)bits;
}

static const operand_rows_row *x86_request_row(const x86_request *request, u32 operand,
                                               const x86_operands_row **family) {
   const iform_operands_row *span;
   const operand_lists_row  *list;

   *family = 0;
   if (request->handle >= X86_HANDLE_COUNT) {
      return 0;
   }

   span = x86_iform_operands + request->handle;
   if (operand >= span->count) {
      return 0;
   }

   list = x86_operand_lists + span->first + operand;
   if (list->family) {
      *family = x86_operand_families + list->family - 1;
   }

   return x86_operand_rows + list->row;
}

