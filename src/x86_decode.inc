FORCE_INLINE u32 x86_decode_code(const x86_context *context, const u8 *bytes, u32 size) {
   nyasm_instruction found;
   u32               handle;
   u32               length = 0;

   if (LIKELY(context->fast && size >= NYASM_BYTES)) {
      length = x86_decode_fast(&x86_hot, context->custom, bytes, &handle);
   }

   if (!length && context->fast && size >= NYASM_BYTES && !(context->custom & X86_FAST_CUSTOM)) {
      length = x86_decode_extended(bytes, &handle);
   }

   if (LIKELY(length)) {
      return X86_CODE(handle, length, 0);
   }

   length = x86_decode_full(context, bytes, size, &found);
   if (length) {
      return X86_CODE(found.handle, length, 0);
   }

   return X86_CODE(0, 1, found.error);
}

#define X86_CHUNK_END(chunk) (bytes + (chunk + 1u) * X86_CHUNK_BYTES)
#define X86_NO_OFFSET        0xFFFFFFFFu
#define X86_CHUNK_STEP(chunk)                                     \
   l = x86_decode_fast(hot, avoid, p##chunk, &h);                 \
   c = X86_CODE(h, l, 0);                                         \
   if (UNLIKELY(!l)) {                                            \
      c = x86_decode_code(context, p##chunk, NYASM_BYTES + 8);    \
      l = NYASM_CODE_LENGTH(c);                                   \
   }                                                              \
                                                                  \
   store32(o##chunk, c);                                          \
   o##chunk += 4;                                                 \
   p##chunk += l;

#define X86_CHUNK_JOIN(chunk)                                                \
   first  = codes + 4 * chunk * X86_CHUNK_CODES;                             \
   offset = chunk * X86_CHUNK_BYTES;                                         \
   while (place < (chunk + 1u) * X86_CHUNK_BYTES) {                          \
      while (first < o##chunk && offset < place) {                           \
         offset += NYASM_CODE_LENGTH(load32(first));                         \
         first  += 4;                                                        \
      }                                                                      \
                                                                             \
      if (offset == place) {                                                 \
         break;                                                              \
      }                                                                      \
                                                                             \
      if (last + 4 > first) {                                                \
         first  = o##chunk;                                                  \
         offset = X86_NO_OFFSET;                                             \
      }                                                                      \
                                                                             \
      c = x86_decode_code(context, bytes + place, NYASM_BYTES + 8);          \
      store32(last, c);                                                      \
      last  += 4;                                                            \
      place += NYASM_CODE_LENGTH(c);                                         \
   }                                                                         \
                                                                             \
   if (place < (chunk + 1u) * X86_CHUNK_BYTES) {                             \
      for (; first < o##chunk; first += 4) {                                 \
         store32(last, load32(first));                                       \
         last += 4;                                                          \
      }                                                                      \
                                                                             \
      place = (u32)(p##chunk - bytes);                                       \
   }

static u32 x86_decode_chunks(const x86_context *context, const u8 *bytes, u8 *codes, u32 *used) {
   const x86_hot_tables *hot   = &x86_hot;
   const u8             *p0    = bytes;
   const u8             *p1    = bytes + X86_CHUNK_BYTES;
   u8                   *o0    = codes;
   u8                   *o1    = codes + 4 * X86_CHUNK_CODES;
   u8                   *first;
   u8                   *last;
   u32                   avoid = context->custom;
   u32                   place;
   u32                   offset;
   u32                   c;
   u32                   h;
   u32                   l;

   PREFETCH(bytes + X86_BLOCK_BYTES);
   PREFETCH(bytes + X86_BLOCK_BYTES + 64);
   while (p0 < X86_CHUNK_END(0) && p1 < X86_CHUNK_END(1)) {
      X86_CHUNK_STEP(0)
      X86_CHUNK_STEP(1)
   }

   while (p0 < X86_CHUNK_END(0)) {
      X86_CHUNK_STEP(0)
   }

   while (p1 < X86_CHUNK_END(1)) {
      X86_CHUNK_STEP(1)
   }

   last  = o0;
   place = (u32)(p0 - bytes);
   X86_CHUNK_JOIN(1)
   *used = place;
   return (u32)(last - codes) / 4;
}

static u32 x86_decode_compact(const x86_context *context, const u8 *bytes, u32 size, u32 *codes, u32 capacity,
                              u32 *used) {
   u32 total = 0;
   u32 place = 0;
   u32 taken;
   u32 code;

   while (context->fast && size - place >= X86_BLOCK_BYTES + 2 * NYASM_BYTES + 8
          && capacity - total >= X86_BLOCK_CODES) {
      total += x86_decode_chunks(context, bytes + place, (u8 *)(codes + total), &taken);
      place += taken;
   }

   if (total && size - place >= X86_BLOCK_BYTES + 2 * NYASM_BYTES + 8) {
      *used = place;
      return total;
   }

   while (total < capacity && place < size) {
      code         = x86_decode_code(context, bytes + place, size - place);
      codes[total] = code;
      place       += NYASM_CODE_LENGTH(code);
      ++total;
   }

   *used = place;
   return total;
}

static u32 x86_decode_block(const x86_context *context, const u8 *bytes, u32 size, nyasm_instruction *found,
                            u32 capacity, u32 *used) {
   nyasm_instruction *record;
   u8                *scratch;
   u32                total = 0;
   u32                place = 0;
   u32                taken;
   u32                count;
   u32                index;
   u32                code;
   u32                length;

   while (context->fast && size - place >= X86_BLOCK_BYTES + 2 * NYASM_BYTES + 8
          && capacity - total >= X86_BLOCK_CODES) {
      scratch = (u8 *)(found + total) + X86_BLOCK_CODES * (sizeof(nyasm_instruction) - sizeof(u32));
      count   = x86_decode_chunks(context, bytes + place, scratch, &taken);
      for (index = 0; index < count; ++index) {
         code           = load32(scratch + 4 * index);
         record         = found + total + index;
         record->handle = NYASM_CODE_HANDLE(code);
         record->length = NYASM_CODE_LENGTH(code);
         record->error  = NYASM_CODE_ERROR(code);
         copy16(record->bytes, bytes + place);
         place         += NYASM_CODE_LENGTH(code);
      }

      total += count;
   }

   if (total && size - place >= X86_BLOCK_BYTES + 2 * NYASM_BYTES + 8) {
      *used = place;
      return total;
   }

   while (total < capacity && place < size) {
      record = found + total;
      length = x86_decode(context, bytes + place, size - place, record);
      if (!length) {
         record->bytes[0] = bytes[place];
         record->length   = 1;
         length           = 1;
      }

      place += length;
      ++total;
   }

   *used = place;
   return total;
}

static u32 x86_decode_l1(const x86_context *context, const u8 *bytes, u32 size, nyasm_instruction *found,
                         u32 capacity, u32 *used) {
   if (capacity != 1) {
      return x86_decode_block(context, bytes, size, found, capacity, used);
   }

   *used = x86_decode(context, bytes, size, found);
   if (UNLIKELY(!*used && size)) {
      found->bytes[0] = bytes[0];
      found->length   = 1;
      *used           = 1;
   }

   return *used != 0;
}
