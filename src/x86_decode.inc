      selection->address_bytes = x86_address_bytes[modrm] + 4 * ((modrm & 0xC7) == 0x04 && (bytes[at + 1] & 7) == 5);
   }

   selection->immediate_at = at + (entry->layout != X86_LAYOUT_BARE) + selection->address_bytes;
   selection->length       = selection->immediate_at + (entry->immediates & 15) + (entry->immediates >> 4);
   if (selection->length > NYASM_X86_MAX_LENGTH) {
      return 0;
   }

   return selection->length;
}

static u32 x86_detail_fast(const u8 *bytes, nyasm_x86_detail *parts) {
   const x86_entry *entry;
   x86_selection    selection;
   u32              legacy;

   if (!x86_select_generic(bytes, &selection)) {
      return 0;
   }

   entry                  = selection.entry;
   legacy                 = selection.scan.legacy;
   parts->escape          = (u8)selection.escape;
   parts->handle          = entry->handle;
   parts->encoding        = entry->encoding;
   parts->operand_size    = entry->size;
   parts->address_size    = x86_address_sizes[X86_SELECT_MODE * 2 + (legacy >> 1 & 1)];
   parts->prefixes        = (u8)legacy;
   parts->repeat          = (u8)selection.scan.repeat;
   parts->segment         = (u8)selection.scan.segment;
   parts->map             = (u8)selection.map;
   parts->opcode          = (u8)selection.opcode;
   parts->flags           = (u8)(NYASM_X86_DETAIL_LONG_MODE | NYASM_X86_DETAIL_REX * (selection.scan.rex != 0));
   parts->flags          |= (u8)(NYASM_X86_DETAIL_MEMORY * selection.memory
                                 | NYASM_X86_DETAIL_MODRM * (entry->layout != X86_LAYOUT_BARE));
   parts->immediate_size  = entry->immediates & 15;
   parts->immediate2_size = entry->immediates >> 4;
   x86_fill_detail(parts, bytes, selection.payload_at, selection.at, selection.address_bytes, selection.immediate_at,
                   selection.scan.rex);
   return parts->length;
}

static u32 x86_match_bucket(x86_walk_state *state, const x86_buckets_row *bucket, u32 *chosen) {
   x86_fields plain;
   x86_fields trial;
   u32        tried   = 0;
   u32        matched = 0;
   u32        best    = ~0u;
   u32        cause   = NYASM_ERROR_NONE;
   u32        index;
   u32        encoding;
   u32        flags;
   u32        reason;
   u32        field;
   u32        misses;
   u32        rank;

   x86_copy_fields(&plain, &state->fields);
   for (index = 0; index < bucket->count; ++index) {
      encoding = x86_candidates[bucket->first + index];
      flags    = x86_attributes[x86_encodings[encoding].attributes].flags;
      reason   = NYASM_ERROR_NONE;
      misses   = 0;
      field    = 0;
      if (!state->has_modrm && (flags & X86_FLAG_MODRM)) {
         continue;
      }

      x86_copy_fields(&trial, &plain);
      x86_apply_aliases(&trial, x86_escapes + state->escape, state->bytes + state->payload_at, flags);

      if (!x86_matches_implicant(&trial, x86_encodings[encoding].implicant)) {
         misses = x86_count_mismatches(&trial, x86_encodings[encoding].implicant, &field);
         reason = x86_cause(encoding, field);
      }

      rank = misses << 16 | (u32)x86_weak_errors[reason] << 15 | tried;
      if (rank < best) {
         best  = rank;
         cause = reason;
      }

      if (!misses) {
         x86_copy_fields(&state->fields, &trial);
         matched += 1;
         *chosen  = encoding;
      }

      tried += 1;
   }

   if (matched == 1) {
      return NYASM_ERROR_NONE;
   }

   if (!cause) {
      return NYASM_ERROR_UNALLOCATED;
   }

   return cause;
}

static u32 x86_finish_walk(x86_walk_state *state, nyasm_x86_detail *parts, u32 *error, u32 encoding, u32 mode,
                           u32 address, const x86_prefix_scan *scan) {
   const x86_attributes_row *row    = x86_attributes + x86_encodings[encoding].attributes;
   const u8                 *fields = state->fields.value;
   u32                       flags  = row->flags;
   u32                       evex   = fields[X86_FIELD_SPACE] == X86_SPACE_EVEX;
   u32                       narrow = fields[X86_FIELD_OSZ];
   const u8                 *order;
   u32                       sizes[X86_SLOT_COUNT];
   u32                       memory;
   u32                       size;
   u32                       handle;
   u32                       immediate_at;
   u32                       distinct;
   u32                       first;
   u32                       index;

   narrow |= x86_narrow(fields);

   size   = X86_WIDTH_OF(row->width_rule, mode, narrow, fields[X86_FIELD_W]);
   memory = state->has_modrm && state->modrm < X86_REGISTER_FORM && !(flags & X86_FLAG_IGNORE_MOD);
   if ((flags & X86_FLAG_MODRM) && !x86_escapes[state->escape].last && memory) {
      x86_read_address(state, address);
   }

   if (state->has_modrm && !(flags & X86_FLAG_MODRM)) {
      state->at       -= 1;
      state->modrm_at  = 0;
      state->has_modrm = 0;
      memory           = 0;
   }

   immediate_at = state->at;
   first        = 0;
   order        = x86_slot_sizes(row, size, address, sizes);
   for (index = 0; index < X86_SLOT_COUNT; ++index) {
      x86_read_bytes(state, sizes[order[index]]);
      if (!first) {
         first = sizes[order[index]];
      }
   }

   if (state->error) {
      return x86_fail(error, state->error);
   }

   if (x86_encodings[encoding].variant == X86_NO_VARIANT) {
      return x86_fail(error, NYASM_ERROR_UNALLOCATED);
   }

   handle = x86_variant_handle(x86_encodings[encoding].variant, size, address, evex && memory && state->broadcast,
                               fields[X86_FIELD_NF], mode);
   if (!handle) {
      return x86_fail(error, NYASM_ERROR_MODE);
   }

   parts->handle          = (u16)handle;
   parts->encoding        = (u16)encoding;
   parts->operand_size    = (u8)size;
   parts->address_size    = (u8)address;
   parts->prefixes        = (u8)scan->legacy;
   parts->repeat          = (u8)scan->repeat;
   parts->segment         = (u8)scan->segment;
   parts->escape          = (u8)state->escape;
   parts->map             = fields[X86_FIELD_MAP];
   parts->opcode          = (u8)state->opcode;
   parts->flags           = (u8)(NYASM_X86_DETAIL_LONG_MODE * (mode == 2) | NYASM_X86_DETAIL_REX * (scan->rex != 0));
   parts->flags          |= (u8)(NYASM_X86_DETAIL_MODRM * state->has_modrm | NYASM_X86_DETAIL_MEMORY * memory);
   parts->immediate_size  = (u8)first;
   parts->immediate2_size = (u8)(state->at - immediate_at - first);
   x86_fill_detail(parts, state->bytes, state->payload_at, state->modrm_at, state->address_bytes * memory,
                   immediate_at, scan->rex);
   distinct = x86_distinct(encoding, fields, parts->sib);
   if (distinct) {
      return x86_fail(error, distinct);
   }

   return parts->length;
}

static COLD u32 x86_walk(const x86_context *context, const u8 *bytes, u32 size, nyasm_x86_detail *parts,
                         u32 *failure) {
   x86_walk_state         walk;
   x86_walk_state        *state  = &walk;
   x86_fields            *values = &walk.fields;
   const u8              *fields = values->value;
   const x86_buckets_row *bucket;
   x86_prefix_scan        scan;
   u32                    mode   = context->mode;
   u32                    address;
   u32                    chosen = 0;
   u32                    needs  = 0;
   u32                    every  = ~0u;
   u32                    page;
   u32                    index;
   u32                    flags;
   u32                    error;
   u32                    memory;

   x86_copy_fields(&state->fields, &context->fields);
   state->bytes         = bytes;
   state->limit         = size;
   state->excess        = size > NYASM_X86_MAX_LENGTH;
   state->error         = 0;
   state->opcode        = 0;
   state->modrm         = 0;
   state->has_modrm     = 0;
   state->modrm_at      = 0;
   state->address_bytes = 0;
   state->escape        = NYASM_X86_ESCAPE_NONE;
   state->broadcast     = 0;
   state->payload_at    = 0;
   if (state->excess) {
      state->limit = NYASM_X86_MAX_LENGTH;
   }

   x86_scan_prefixes(bytes, state->limit, mode, &scan);
   state->at = scan.at;
   address   = x86_address_sizes[mode * 2 + (scan.legacy >> 1 & 1)];
   x86_set_field(values, X86_FIELD_OSZ, scan.legacy & 1);
   x86_set_field(values, X86_FIELD_ASZ, scan.legacy >> 1 & 1);
   x86_set_field(values, X86_FIELD_LOCK, scan.legacy >> 2);
   x86_set_field(values, X86_FIELD_REP, scan.repeat);
   x86_set_field(values, X86_FIELD_EASZ, address >> 5);
   x86_set_field(values, X86_FIELD_REX, scan.rex != 0);
   x86_set_field(values, X86_FIELD_PP, scan.repeat);
   if (scan.legacy & 1) {
      x86_set_field(values, X86_FIELD_PP, 1);
   }

   x86_read_unit(values, X86_UNIT_REX, scan.rex);
   x86_read_escape(state, mode);
   if (state->error) {
      return x86_fail(failure, state->error);
   }

   error = x86_check_rules(values, X86_STAGE_PREFIX, 0);
   if (error) {
      return x86_fail(failure, error);
   }

   if (x86_escapes[state->escape].last) {
      state->modrm_at  = state->at;
      state->modrm     = (u32)x86_read_bytes(state, 1);
      state->has_modrm = 1;
      x86_read_address(state, address);
      state->opcode = (u32)x86_read_bytes(state, 1);
   }

   if (state->error) {
      return x86_fail(failure, state->error);
   }

   page = x86_pages[fields[X86_FIELD_SPACE] * X86_MAP_COUNT + fields[X86_FIELD_MAP]];
   if (!page || !x86_buckets[(page - 1) * X86_BYTE_VALUES + state->opcode].count) {
      return x86_fail(failure, NYASM_ERROR_UNALLOCATED);
   }

   bucket = x86_buckets + (page - 1) * X86_BYTE_VALUES + state->opcode;
   for (index = 0; index < bucket->count; ++index) {
      flags  = x86_attributes[x86_encodings[x86_candidates[bucket->first + index]].attributes].flags;
      needs |= flags;
      every &= flags;
   }

   if (!state->has_modrm && (needs & X86_FLAG_MODRM) && state->at < state->limit) {
      state->modrm_at  = state->at;
      state->modrm     = (u32)x86_read_bytes(state, 1);
      state->has_modrm = 1;
   }

   if (!state->has_modrm && (every & X86_FLAG_MODRM)) {
      return x86_fail(failure, x86_truncation(state));
   }

   x86_read_unit(values, X86_UNIT_MODRM, state->modrm);
   x86_read_unit(values, X86_UNIT_OPCODE, state->opcode);
   error = x86_check_rules(values, X86_STAGE_MODRM, 0);
   if (error) {
      return x86_fail(failure, error);
   }

   memory           = state->has_modrm && state->modrm < X86_REGISTER_FORM;
   state->broadcast = fields[X86_FIELD_EVEX_B];
   x86_bind_conditional(values, x86_escapes + state->escape, bytes + state->payload_at, memory);
   error = x86_match_bucket(state, bucket, &chosen);
   if (!error) {
      flags = x86_attributes[x86_encodings[chosen].attributes].flags;
      error = x86_check_rules(values, X86_STAGE_CHOSEN, flags);
   }

   if (error) {
      return x86_fail(failure, error);
   }

   return x86_finish_walk(state, parts, failure, chosen, mode, address, &scan);
}

static void x86_context_refresh(x86_context *context) {
   context->tables = context->mode == X86_SELECT_MODE && context->stack == X86_SELECT_MODE;
   context->fast   = context->tables && !context->gate;
   context->custom = (u8)(X86_FAST_SLOW | X86_FAST_VARY
                          | X86_FAST_CUSTOM * (context->decoding != X86_DEFAULT_DECODING));
}

static u32 x86_context_mode(x86_context *context, u32 mode, u32 stack) {
   if (mode >= NYASM_X86_MODE_COUNT || stack >= NYASM_X86_STACK_COUNT) {
      return 0;
   }

   x86_set_field(&context->fields, X86_FIELD_MODE, mode);
   x86_set_field(&context->fields, X86_FIELD_SSZ, stack);
   context->mode  = (u8)mode;
   context->stack = (u8)stack;
   x86_context_refresh(context);
   return 1;
}

static void x86_context_features(x86_context *context, const u64 *features) {
   u32 index;
   u32 on;

   for (index = 0; index < X86_FEATURE_WORDS; ++index) {
      context->features[index] = features[index];
   }

   context->decoding = 0;
   for (index = 0; index < X86_DECODING_COUNT; ++index) {
      on                 = BIT_HELD(features, x86_feature_places[index]);
      context->decoding |= on << index;
      x86_set_field(&context->fields, x86_feature_fields[index], on);
   }
}

static u32 x86_context_init(x86_context *context, u32 mode) {
   x86_fields *values = &context->fields;
   u32         index;

   for (index = 0; index < COUNT_OF(values->vector); ++index) {
      values->vector[index] = 0;
   }

   for (index = 0; index < COUNT_OF(values->value); ++index) {
      values->value[index] = 0;
   }

   for (index = 0; index < X86_FIELD_COUNT; ++index) {
      x86_set_field(values, index, x86_field_rows[index].initial);
   }

   context->syntax = 0;
   context->chip   = X86_NO_CHIP;
   context->gate   = 0;
   x86_context_features(context, x86_default_features);
   x86_context_mode(context, NYASM_X86_MODE_64, NYASM_X86_STACK_64);
   return x86_context_mode(context, mode, mode);
}

static u32 x86_context_chip(x86_context *context, u32 chip) {
   if (chip >= NYASM_X86_CHIP_COUNT) {
      return 0;
   }

   context->chip = (u16)chip;
   context->gate = 1;
   x86_context_features(context, x86_chips[chip].features);
   x86_context_refresh(context);
   return 1;
}

static void x86_context_feature(x86_context *context, u32 feature, u32 on) {
   u32 index;

   if (feature >= BITS_OF(context->features)) {
      return;
   }

   on                                    = on != 0;
   context->gate                         = 1;
   context->features[BIT_WORD(feature)] &= ~BIT_MASK(feature);
   context->features[BIT_WORD(feature)] |= BIT_MASK(feature) & (0 - (u64)on);
   for (index = 0; index < X86_DECODING_COUNT; ++index) {
      if (x86_feature_places[index] == feature) {
         x86_set_field(&context->fields, x86_feature_fields[index], on);
         context->decoding = (context->decoding & ~(1u << index)) | on << index;
      }
   }

   x86_context_refresh(context);
}

static u32 x86_lde(u32 mode, const u8 *bytes, u32 limit, x86_layout *layout) {
   const x86_escape *escape;
   u8                fields[X86_FIELD_COUNT];
   u32               asz;
   u32               narrow;
   u32               index;
   u32               kinds;
   u32               tails = 1;
   u32               at;

   x86_scan_prefixes(bytes, limit, mode, &layout->scan);
   at = layout->scan.at;
   if (at >= limit) {
      return 0;
   }

   layout->escape     = x86_find_escape(bytes, at, limit, mode);
   escape             = x86_escapes + layout->escape;
   layout->payload_at = at + escape->bytes;
   layout->map        = escape->map;
   layout->wide       = layout->scan.rex >> 3 & 1;
   layout->pp         = layout->scan.repeat;
   narrow             = layout->scan.legacy & escape->prefixed;
   asz                = layout->scan.legacy >> 1 & 1;
   at                 = layout->payload_at + escape->units;
   if (at > X86_LAST_OPCODE) {
      return 0;
   }

   if (narrow) {
      layout->pp = 1;
   }

   if (escape->units) {
      layout->wide = 0;
      layout->pp   = 0;
   }

   if (escape->map_unit != X86_NO_REGISTER) {
      layout->map = bytes[layout->payload_at + escape->map_unit] >> escape->map_low & escape->map_mask;
   }

   if (escape->wide_unit != X86_NO_REGISTER) {
      layout->wide = bytes[layout->payload_at + escape->wide_unit] >> escape->wide_low & 1;
   }

   if (escape->pp_unit != X86_NO_REGISTER) {
      layout->pp = bytes[layout->payload_at + escape->pp_unit] >> escape->pp_low & 3;
   }

   if (layout->map >= 16) {
      return 0;
   }

   for (index = 0; index < X86_FIELD_COUNT; ++index) {
      fields[index] = 0;
   }

   fields[X86_FIELD_SPACE] = escape->space;
   fields[X86_FIELD_MAP]   = (u8)layout->map;
   fields[X86_FIELD_PP]    = (u8)layout->pp;
   narrow                 |= x86_narrow(fields);
   layout->opcode_at       = at;
   layout->modrm_at        = at + 1;
   layout->kind            = 1;
   layout->modrm           = 0;
   layout->address_bytes   = 0;
   if (escape->last) {
      layout->modrm_at = at;
   } else {
      index = X86_LDE_ROW(mode, escape->space, layout->map, bytes[at]);
      kinds = x86_lde_kinds[index];
      tails = x86_lde_tails[index];
      if ((kinds & X86_LDE_UNKNOWN) == X86_LDE_UNKNOWN) {
         return 0;
      }

      if (kinds & X86_LDE_UNKNOWN) {
         index = X86_GROUP_ROW(tails, layout->pp);
         if (kinds & X86_LDE_VARY_REG) {
            index = X86_GROUP_ROW(tails, X86_REG_OF(bytes[at + 1]));
         }

         kinds = x86_lde_group_kinds[index];
         tails = x86_lde_group_tails[index];
      }

      layout->kind = kinds & 3;
      tails        = tails >> (4 * (narrow | layout->wide << 1 | asz << 2)) & 15;
   }

   if (layout->kind) {
      layout->modrm = bytes[layout->modrm_at];
      if (layout->kind == 1) {
         index                 = 32 - 16 * ((mode == 1 && asz) || (mode == 0 && !asz));
         layout->address_bytes = x86_address_length(bytes + layout->modrm_at + 1, layout->modrm, index, 1);
      }
   }

   if (escape->last) {
      layout->opcode_at = layout->modrm_at + 1 + layout->address_bytes;
      layout->length    = layout->opcode_at + 1;
   } else {
      layout->length = at + 1 + (layout->kind != 0) + layout->address_bytes + tails;
   }

   layout->immediate_bytes = tails;
   if (layout->length > limit || layout->length > NYASM_X86_MAX_LENGTH) {
      return 0;
   }

   return layout->length;
}

static u32 x86_select_layout(const u8 *bytes, const x86_layout *layout) {
   const x86_compact_row *row;
   u32                    index;

   if (!x86_compact_pages[layout->escape]) {
      return 0;
   }

   row    = x86_compact_rows + (x86_compact_pages[layout->escape] - 1u) * X86_BYTE_VALUES + bytes[layout->opcode_at];
   index  = row->first + x86_hot.modrm_classes[row->classes + bytes[layout->opcode_at + 1]];
   index += row->wide & (0u - layout->wide);
   index += x86_compact_prefixes[row->prefix * 32 + (layout->scan.legacy | layout->scan.repeat << 3)];
   return x86_compact_entries[index] & 0xFFFF;
}

static u32 x86_select_units(const u8 *bytes, const x86_layout *layout) {
   const x86_escape *escape = x86_escapes + layout->escape;
   const x86_select *select;
   u32               keys[4];
   u32               modrm  = bytes[layout->opcode_at + 1];
   u32               page   = x86_select_pages[layout->escape * X86_SELECT_MAPS + layout->map];
   u32               row;
   u32               index;

   if (!page || layout->scan.rex || (!escape->prefixed && (layout->scan.legacy | layout->scan.repeat))) {
      return 0;
   }

   for (index = 0; index < 4; ++index) {
      keys[index] = 0;
   }

   for (index = 0; index < escape->units; ++index) {
      keys[index] = bytes[layout->payload_at + index];
   }

   if (escape->prefixed) {
      keys[escape->units] = layout->scan.legacy | layout->scan.repeat << 3;
   }

   row    = page - 1 + (bytes[layout->opcode_at] << escape->halved) + ((modrm >= X86_REGISTER_FORM) & escape->halved);
   select = x86_selects + row;
   index  = select->first + X86_CLASS_OF(select, modrm);
   index += X86_AXIS(select, 0, keys[0]);
   index += X86_AXIS(select, 1, keys[1]);
   index += X86_AXIS(select, 2, keys[2]);
   if (!x86_select_usable[row]) {
      return 0;
   }

   return x86_entry_handles[index];
}

FORCE_INLINE u32 x86_decode_fast(const x86_hot_tables *hot, u32 avoid, const u8 *bytes, u32 *handle) {
   const x86_fast_row *row;
   u64                 x = load64_little(bytes);
   u32                 c = hot->lead_first[x & 0xFF] + (hot->lead_second[x >> 8 & 0xFF] & hot->lead_masks[x & 0xFF]);
   u32                 n = c & 3;
   u64                 y = x >> (8 * n);
   u32                 e = ((u32)y & 0xFF) == 0x0F;
   u32                 z = (u32)(y >> (8 * e));
   u32                 m = z >> 8 & 0xFF;
   u32                 k = c >> 2;
   u32                 i;
   u32                 j;

   row     = hot->fast_rows + e * X86_BYTE_VALUES + (z & 0xFF);
   i       = row->first + hot->fast_keys[row->keys + k] + hot->modrm_classes[row->classes + m];
   j       = row->lengths;
   *handle = hot->compact_handles[i];
   if (UNLIKELY(row->flags & avoid)) {
      if ((row->flags & avoid) != X86_FAST_VARY) {
         return 0;
      }

      j = hot->fast_groups[j + X86_REG_OF(m)];
   }

   if (UNLIKELY(!*handle)) {
      return 0;
   }

   return n + e + hot->fast_lengths[j + k] + (hot->fast_address[X86_ADDRESS_KEY(z)] & row->memory);
}

FORCE_INLINE const x86_entry *x86_find_extended(const u8 *bytes, u32 *opcode_at, u32 *number) {
   const x86_extended_escape *escape = x86_extended_escapes + bytes[0];
   const x86_select          *select;
   const x86_entry           *entry;
   u32                        at     = 1u + escape->units;
   u32                        modrm  = bytes[at + 1];
   u32                        bytes2 = bytes[2] & escape->second;
   u32                        bytes3 = bytes[3] & escape->third;
   u32                        index;
   u32                        page;
   u32                        map;
   u32                        row;

   map = escape->map | (bytes[1 + escape->map_unit] >> escape->map_low & escape->map_mask);
   if (!escape->escape || map >= X86_MAP_COUNT) {
      return 0;
   }

   page = x86_select_pages[escape->escape * X86_SELECT_MAPS + map];
   if (!page) {
      return 0;
   }

   row    = page - 1 + (bytes[at] << escape->halved) + ((modrm >= X86_REGISTER_FORM) & escape->halved);
   select = x86_selects + row;
   index  = select->first + X86_CLASS_OF(select, modrm);
   index += X86_AXIS(select, 0, bytes[1]);
   index += X86_AXIS(select, 1, bytes2);
   index += X86_AXIS(select, 2, bytes3);
   entry  = x86_entries + index;
   if (!x86_select_usable[row] || !entry->handle) {
      return 0;
   }

   *opcode_at = at;
   *number    = escape->escape;
   return entry;
}

static u32 x86_decode_general(const u8 *bytes, u32 *handle) {
   x86_selection selection;

   if (!x86_select_generic(bytes, &selection)) {
      return 0;
   }

   *handle = selection.entry->handle;
   return selection.length;
}

static u32 x86_decode_extended(const u8 *bytes, u32 *handle) {
   const x86_entry *entry;
   u32              number  = 0;
   u32              at      = 0;
   u32              address = 0;
   u32              length;

   entry = x86_find_extended(bytes, &at, &number);
   if (!entry) {
      return x86_decode_general(bytes, handle);
   }

   if (entry->layout == X86_LAYOUT_MODRM) {
      address = x86_hot.fast_address[bytes[at + 1] | (bytes[at + 2] & 7) << 8];
   }

   *handle = entry->handle;
   length  = at + 1 + (entry->layout != X86_LAYOUT_BARE) + address;
   length += (entry->immediates & 15) + (entry->immediates >> 4);
   if (length > NYASM_X86_MAX_LENGTH) {
      return 0;
   }

   return length;
}

static u32 x86_pick(const x86_context *context, const u8 *bytes, const x86_layout *layout) {
   const x86_escape *escape = x86_escapes + layout->escape;
   u32               kinds  = x86_lde_kinds[X86_LDE_ROW(X86_SELECT_MODE, escape->space, layout->map,
                                                        bytes[layout->opcode_at])];
   u32               handle = 0;

   if (!context->tables) {
      return 0;
   }

   if (!(kinds & context->custom & X86_LDE_CUSTOM)) {
      handle = x86_select_layout(bytes, layout);
   }

   if (!handle && escape->units && !(context->custom & X86_FAST_CUSTOM)) {
      handle = x86_select_units(bytes, layout);
   }

   if (handle && context->gate && !x86_has_features(context->features, handle)) {
      return 0;
   }

   return handle;
}

static u32 x86_decode_full(const x86_context *context, const u8 *bytes, u32 size, nyasm_instruction *found) {
   nyasm_x86_detail parts;
   x86_layout       layout;
   const u8        *source = bytes;
   u8               padded[NYASM_BYTES + 8];
   u32              error  = NYASM_ERROR_NONE;
   u32              handle = 0;
   u32              limit  = size;
   u32              length;
   u32              index;

   if (size < COUNT_OF(padded)) {
      for (index = 0; index < COUNT_OF(padded); ++index) {
         padded[index] = 0;
      }

      for (index = 0; index < size; ++index) {
         padded[index] = bytes[index];
      }

      source = padded;
   }

   if (limit > NYASM_X86_MAX_LENGTH) {
      limit = NYASM_X86_MAX_LENGTH;
   }

   length = x86_lde(context->mode, source, limit, &layout);
   if (length) {
      handle = x86_pick(context, source, &layout);
   }

   if (!handle) {
      length = x86_walk(context, source, size, &parts, &error);
      if (length && context->gate && !x86_has_features(context->features, parts.handle)) {
         length = 0;
         error  = NYASM_ERROR_FEATURE;
      }

      if (length) {
         handle = parts.handle;
      }
   }

   found->handle = (u16)handle;
   found->length = (u8)length;
   found->error  = (u8)error;
   copy16(found->bytes, source);
   return length;
}

FORCE_INLINE u32 x86_decode(const x86_context *context, const u8 *bytes, u32 size, nyasm_instruction *found) {
   u32 handle;
   u32 length;

   if (UNLIKELY(!context->fast || size < NYASM_BYTES)) {
      return x86_decode_full(context, bytes, size, found);
   }

   length = x86_decode_fast(&x86_hot, context->custom, bytes, &handle);
   if (UNLIKELY(!length)) {
      if (!(context->custom & X86_FAST_CUSTOM)) {
         length = x86_decode_extended(bytes, &handle);
      }

      if (!length) {
         return x86_decode_full(context, bytes, size, found);
      }
   }

   found->handle = (u16)handle;
   found->length = (u8)length;
   found->error  = 0;
   copy16(found->bytes, bytes);
   return length;
}

FORCE_INLINE u64 x86_read_window(const u8 *bytes, u32 at, u32 count) {
   u32 over = (at - X86_WINDOW_SLACK) & (0u - (at > X86_WINDOW_SLACK));

   return load64_little(bytes + at - over) >> (8 * over) & X86_KEEP(count);
}

FORCE_INLINE u64 x86_view_immediate(const u8 *bytes, const x86_view *view, u32 second) {
   u32 at   = view->immediate_at;
   u32 size = X86_VIEW_IMMEDIATE(view);

   if (second) {
      at  += size;
      size = X86_VIEW_IMMEDIATE2(view);
   }

   return x86_read_window(bytes, at, size);
}

FORCE_INLINE x86_view x86_view_quick(const u8 *bytes, u32 avoid) {
   const x86_hot_tables *hot   = &x86_hot;
   const x86_fast_row   *row;
   x86_view              view  = { 0 };
   u64                   x     = load64_little(bytes);
   u32                   c     = hot->lead_first[x & 0xFF]
                                 + (hot->lead_second[x >> 8 & 0xFF] & hot->lead_masks[x & 0xFF]);
   u32                   n     = c & 3;
   u64                   y     = x >> (8 * n);
   u32                   e     = ((u32)y & 0xFF) == 0x0F;
   u32                   z     = (u32)(y >> (8 * e));
   u32                   m     = z >> 8 & 0xFF;
   u32                   rex   = (u32)(x << 8 >> (8 * n)) & 0xFF;
   u32                   index;
   u32                   flags;
   u32                   address;
   u32                   sib;
   u32                   at;

   row = hot->fast_rows + e * X86_BYTE_VALUES + (z & 0xFF);
   if (UNLIKELY(row->flags & avoid & ~X86_FAST_VARY)) {
      return view;
   }

   rex                   &= 0u - (rex >> 4 == X86_REX_GROUP);
   index                  = row->first + hot->fast_keys[row->keys + (c >> 2)] + hot->modrm_classes[row->classes + m];
   view.packed            = x86_compact_details[index];
   view.handle            = hot->compact_handles[index];
   flags                  = x86_modrm_details[(view.packed >> X86_ENTRY_LAYOUT_AT & 3) * X86_BYTE_VALUES + m];
   sib                    = (flags & NYASM_X86_DETAIL_SIB) != 0;
   address                = hot->fast_address[X86_ADDRESS_KEY(z)] & (0u - ((flags & NYASM_X86_DETAIL_MEMORY) != 0));
   at                     = n + e + 1 + ((flags & NYASM_X86_DETAIL_MODRM) != 0);
   view.body              = z;
   view.lead              = x86_prefix_details[x & 0xFF];
   view.payload           = rex;
   view.escape            = (u8)(NYASM_X86_ESCAPE_MAP1 * e);
   view.flags             = (u8)(flags | NYASM_X86_DETAIL_REX * (rex != 0));
   view.extension         = (u8)(rex & 15);
   view.displacement_at   = (u8)(at + sib);
   view.displacement_size = (u8)(address - sib);
   view.immediate_at      = (u8)(at + address);
   view.length            = (u8)(at + address + X86_VIEW_IMMEDIATE(&view) + X86_VIEW_IMMEDIATE2(&view));
   if (!view.handle) {
      view.length = 0;
   }

   return view;
}

#if NYASM_FORMAT

static u32 x86_view_extended(const u8 *bytes, u32 avoid, x86_view *view) {
   const x86_entry *entry  = 0;
   u64              x      = load64_little(bytes);
   u32              number = 0;
   u32              at     = 0;
   u32              address;
   u32              payload;
   u32              length;
   u32              flags;
   u32              sizes;
   u32              has;
   u32              sib;

   if (!(avoid & X86_FAST_CUSTOM)) {
      entry = x86_find_extended(bytes, &at, &number);
   }

   if (!entry) {
      return 0;
   }

   flags   = x86_modrm_details[entry->layout * X86_BYTE_VALUES + ((u32)(x >> 8 * (at + 1)) & 0xFF)];
   has     = (flags & NYASM_X86_DETAIL_MODRM) != 0;
   sib     = (flags & NYASM_X86_DETAIL_SIB) != 0;
   address = x86_hot.fast_address[X86_ADDRESS_KEY((u32)(x >> 8 * at))]
             & (0u - ((flags & NYASM_X86_DETAIL_MEMORY) != 0));
   sizes   = entry->immediates;
   length  = at + 1 + has + address + (sizes & 15) + (sizes >> 4);
   payload = (u32)(x >> 8) & ((1u << 8 * (at - 1)) - 1);
   if (length > NYASM_X86_MAX_LENGTH) {
      return 0;
   }

   view->body = (u32)(x >> 8 * at) & (0xFFu | ((0u - has) & 0xFF00u) | ((0u - sib) & 0xFF0000u));
   view->lead = (u32)X86_VIEW_WIDE << X86_LEAD_ADDRESS_AT;
   view->packed            = (u32)entry->encoding | sizes << X86_ENTRY_IMMEDIATES_AT
                             | (u32)entry->size / X86_ENTRY_SIZE_UNIT << X86_ENTRY_SIZE_AT;
   view->payload           = payload;
   view->handle            = entry->handle;
   view->escape            = (u8)number;
   view->flags             = (u8)flags;
   view->extension         = (u8)x86_extension_bits(number, payload, (flags & NYASM_X86_DETAIL_MEMORY) != 0);
   view->length            = (u8)length;
   view->displacement_at   = (u8)(at + 1 + has + sib);
   view->displacement_size = (u8)(address - sib);
   view->immediate_at      = (u8)(at + 1 + has + address);
   return length;
}

static u32 x86_view_general(const u8 *bytes, u32 avoid, x86_view *view) {
   const x86_entry *entry;
   x86_selection    selection;
   u32              payload;
   u32              legacy;
   u32              modrm;
   u32              units;
   u32              has;
   u32              sib;

   if ((avoid & X86_FAST_CUSTOM) || !x86_select_generic(bytes, &selection)) {
      return 0;
   }

   entry   = selection.entry;
   legacy  = selection.scan.legacy;
   units   = x86_escapes[selection.escape].units;
   modrm   = bytes[selection.at];
   has     = entry->layout != X86_LAYOUT_BARE;
   sib     = selection.memory && (modrm & 7) == 4;
   payload = selection.scan.rex;
   if (units) {
      payload = (u32)x86_read_value(bytes + selection.payload_at, units);
   }

   view->body              = selection.opcode | (modrm * has) << 8 | ((u32)bytes[selection.at + has] * sib) << 16;
   view->lead              = legacy | selection.scan.repeat << X86_LEAD_REPEAT_AT
                             | selection.scan.segment << X86_LEAD_SEGMENT_AT
                             | (u32)x86_address_sizes[X86_SELECT_MODE * 2 + (legacy >> 1 & 1)] << X86_LEAD_ADDRESS_AT;
   view->packed            = (u32)entry->encoding | (u32)entry->immediates << X86_ENTRY_IMMEDIATES_AT
                             | (u32)entry->size / X86_ENTRY_SIZE_UNIT << X86_ENTRY_SIZE_AT;
   view->payload           = payload;
   view->handle            = entry->handle;
   view->escape            = (u8)selection.escape;
   view->flags             = (u8)(NYASM_X86_DETAIL_LONG_MODE | NYASM_X86_DETAIL_REX * (selection.scan.rex != 0)
                                  | NYASM_X86_DETAIL_MODRM * has | NYASM_X86_DETAIL_MEMORY * selection.memory
                                  | NYASM_X86_DETAIL_SIB * sib);
   view->extension         = (u8)x86_extension_bits(selection.escape, payload, selection.memory);
   view->length            = (u8)selection.length;
   view->displacement_at   = (u8)(selection.at + has + sib);
   view->displacement_size = (u8)(selection.address_bytes - sib);
   view->immediate_at      = (u8)selection.immediate_at;
   return selection.length;
}

#endif

static u32 x86_detail_quick(const nyasm_instruction *found, nyasm_x86_detail *parts) {
   x86_view view = x86_view_quick(found->bytes, X86_FAST_SLOW);
   u32      has  = view.flags & NYASM_X86_DETAIL_MODRM;
   u32      sib  = (view.flags & NYASM_X86_DETAIL_SIB) != 0;

   if (!view.length || view.handle != found->handle || view.length != found->length) {
      return 0;
   }

   parts->escape            = view.escape;
   parts->handle            = view.handle;
   parts->encoding          = (u16)X86_VIEW_ENCODING(&view);
   parts->operand_size      = (u8)X86_VIEW_SIZE(&view);
   parts->address_size      = (u8)X86_VIEW_ADDRESS(&view);
   parts->prefixes          = (u8)X86_VIEW_PREFIXES(&view);
   parts->repeat            = (u8)X86_VIEW_REPEAT(&view);
   parts->segment           = (u8)X86_VIEW_SEGMENT(&view);
   parts->map               = view.escape == NYASM_X86_ESCAPE_MAP1;
   parts->opcode            = (u8)X86_VIEW_OPCODE(&view);
   parts->flags             = view.flags;
   parts->payload[0]        = (u8)view.payload;
   parts->payload[1]        = 0;
   parts->payload[2]        = 0;
   parts->extension         = view.extension;
   parts->modrm             = (u8)(X86_VIEW_MODRM(&view) * has);
   parts->sib               = (u8)(X86_VIEW_SIB(&view) * sib);
   parts->immediate_size    = (u8)X86_VIEW_IMMEDIATE(&view);
   parts->immediate2_size   = (u8)X86_VIEW_IMMEDIATE2(&view);
   parts->displacement_size = view.displacement_size;
   parts->displacement      = (u32)x86_read_window(found->bytes, view.displacement_at, view.displacement_size);
   parts->immediate         = x86_view_immediate(found->bytes, &view, 0);
   parts->immediate2        = (u16)x86_view_immediate(found->bytes, &view, 1);
   parts->length            = view.length;
   return view.length;
}

static u32 x86_detail_full(const x86_context *context, const nyasm_instruction *found, nyasm_x86_detail *parts) {
   u32 error  = NYASM_ERROR_NONE;
   u32 length = 0;

   if (context->fast) {
      length = x86_detail_fast(found->bytes, parts);
   }

   if (length && parts->handle == found->handle && length == found->length) {
      return length;
   }

   length = x86_walk(context, found->bytes, found->length, parts, &error);
   if (!length || parts->handle != found->handle || length != found->length) {
      return 0;
   }

   return length;
}

static u32 x86_decode_detail(const x86_context *context, const nyasm_instruction *found, nyasm_x86_detail *parts) {
   u32 length = 0;

   if (!found->handle || !found->length) {
      return 0;
   }

   if (context->fast) {
      length = x86_detail_quick(found, parts);
   }

   if (!length) {
      length = x86_detail_full(context, found, parts);
   }

   return length;
}

#if NYASM_FORMAT

static x86_view x86_view_full(const x86_context *context, const nyasm_instruction *found) {
   nyasm_x86_detail parts;
   x86_view         view = { 0 };

   if (!found->handle || !x86_detail_full(context, found, &parts)) {
      return view;
   }

   view.body              = (u32)parts.opcode | (u32)parts.modrm << 8 | (u32)parts.sib << 16;
   view.lead              = (u32)parts.prefixes | (u32)parts.repeat << X86_LEAD_REPEAT_AT
                            | (u32)parts.segment << X86_LEAD_SEGMENT_AT
                            | (u32)parts.address_size << X86_LEAD_ADDRESS_AT;
   view.packed            = (u32)parts.encoding | (u32)parts.immediate_size << X86_ENTRY_IMMEDIATES_AT
                            | (u32)parts.immediate2_size << (X86_ENTRY_IMMEDIATES_AT + 4)
                            | (u32)parts.operand_size / X86_ENTRY_SIZE_UNIT << X86_ENTRY_SIZE_AT;
   view.payload           = (u32)parts.payload[0] | (u32)parts.payload[1] << 8 | (u32)parts.payload[2] << 16;
   view.handle            = parts.handle;
   view.escape            = parts.escape;
   view.flags             = parts.flags;
   view.extension         = parts.extension;
   view.length            = parts.length;
   view.immediate_at      = (u8)(parts.length - parts.immediate_size - parts.immediate2_size);
   view.displacement_at   = (u8)(view.immediate_at - parts.displacement_size - x86_escapes[parts.escape].last);
   view.displacement_size = parts.displacement_size;
   return view;
}

