static u32 riscv32_has_features(const u64 *features, u32 handle) {
   const isa_sets_row *set  = riscv32_isa_sets + riscv32_iform_isa[handle];
   u32                 held = 0;
   u32                 index;
   u32                 item;

   for (index = 0; index < set->count; ++index) {
      item  = riscv32_isa_items[set->first + index];
      held |= BIT_HELD(features, item & FEATURE_MASK);
      if (item & FEATURE_LAST) {
         if (!held) {
            return 0;
         }

         held = 0;
      }
   }

   return 1;
}

static u32 riscv32_mnemonic(u32 handle) {
   if (handle >= COUNT_OF(riscv32_iform_mnemonics)) {
      return 0;
   }

   return riscv32_iform_mnemonics[handle];
}

#if NYASM_FORMAT || NYASM_METADATA || NYASM_UIR

static const char *riscv32_string(u32 string) {
   return (const char *)riscv32_strings + riscv32_string_offsets[string];
}

#endif

#if NYASM_UIR

static const char *riscv32_uir_name(u32 name) {
   if (name >= COUNT_OF(riscv32_uir_names)) {
      return "";
   }

   return riscv32_string(name);
}

#endif

